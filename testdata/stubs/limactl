#!/bin/bash
# Stand-in for limactl in tests. Logs every call to $STUB_LOG, and the folder
# and Lima home of the last one to $STUB_DIR/limactl-env. Answers list --json
# from $STUB_DIR/instances ("name [status]" per line, status defaults to
# Stopped), which create, clone, start, stop and delete keep up to date,
# failing with $STUB_DIR/list-fails and hanging with $STUB_DIR/list-hangs;
# create's template on its input (-) goes to $STUB_DIR/create-template. A
# VM's size ("CPUS MEMORY DISK", in bytes) is $STUB_DIR/size-<name>, else 4
# CPUs, 8 GiB and 100 GiB, which create's --cpus= and --memory= set and
# edit's --cpus, --memory and --disk change. create's, clone's and edit's --set
# go into its config (set_config, below: list shows it, with lima.yaml's env),
# which a clone copies from its source, --mount-none takes the mounts out of,
# and delete forgets with $LIMA_HOME/<name>. The TestLimactlStubContract test
# in internal/backend/lima checks all this against real Lima. A VM's ssh config is $LIMA_HOME/<name>/ssh.config, as start
# writes it (Lima's own options, host keys unchecked) unless it exists; its
# host keys, read with a shell, are one made-up key per VM, unless
# $STUB_DIR/hostkeys-fail exists.
# start writes the VM's ha.pid (devvm's pid, which runs and is soon gone,
# or $STUB_DIR/hostagent's, a pid that lasts) and the SSH agent
# it was given ($SSH_AUTH_SOCK, or "unset") to $STUB_DIR/start-agent-<name>,
# and shell its agent to $STUB_DIR/shell-agent; and
# with $STUB_DIR/start-fails it fails, leaving the VM running (a degraded
# start), and with $STUB_DIR/start-hangs it hangs (touching
# $STUB_DIR/hanging first); with $STUB_DIR/start-hangs-running, for a
# VM whose name contains its text, it hangs once the VM runs and has its
# ha.pid, as Lima's start waits for a VM's ssh while its hostagent runs it. clone fails with $STUB_DIR/clone-fails,
# leaving its instance (a partial clone), and delete with
# $STUB_DIR/delete-fails, after deleting it. rename moves a stopped instance
# (status, config, size and folder) to its new name, and fails with
# $STUB_DIR/rename-fails, changing nothing. shell fails with $STUB_DIR/shell-fails (or when its
# arguments contain $STUB_DIR/shell-fails-on's text) and hangs with
# $STUB_DIR/shell-hangs (touching $STUB_DIR/hanging first), and a direct
# connection (curl --noproxy) fails unless $STUB_DIR/net-direct exists; a script fed
# to shell's bash -s has its second line appended to $STUB_DIR/scripts, and
# the tar stream a VM's setup is sent is kept as $STUB_DIR/sync.tar (with
# $STUB_DIR/sync-fails-with, the setup then fails, and that file is the VM's
# /run/devvm/tools-unmounted). The
# tools build VM writes the images its build.sh is asked for (below). A
# --clone VM's git (git -C DIR, the script that makes its clone and the
# one that reads a worktree's status) runs here, on $STUB_DIR/vmfs/DIR:
# the VM's files, which the ssh stub pushes to and fetches from; git
# worktree list gives its paths without that prefix. A shell running assets/oci/build.sh writes what it would
# (below), or fails when $STUB_DIR/build-fails exists. A call whose
# arguments contain $STUB_DIR/interrupt-on's text is Ctrl+C: it interrupts
# devvm, once.
# Everything else succeeds.
set -euo pipefail
"${0%/*}/stub-log" "$STUB_LOG" limactl "$@"
echo "cwd=$(pwd -P) LIMA_HOME=${LIMA_HOME:-}" > "$STUB_DIR/limactl-env"
if [[ -f $STUB_DIR/interrupt-on && "$*" == *"$(cat "$STUB_DIR/interrupt-on")"* ]]; then
  rm "$STUB_DIR/interrupt-on"
  kill -INT "$PPID"
  exit 130
fi
inst="$STUB_DIR/instances"
[[ -f $inst ]] || : > "$inst"
# set_status NAME [STATUS]: no status removes it.
set_status() {
  { grep -v "^$1\( \|$\)" "$inst" || true; [[ -z ${2:-} ]] || echo "$1 $2"; } > "$inst.new"
  mv "$inst.new" "$inst"
}
# The VM names among the arguments (not options, nor their values).
names=()
skip=""
for a in "${@:2}"; do
  if [[ -n $skip ]]; then skip=""; continue; fi
  case $a in
    --set|--mount-only|--name|--workdir|--cpus|--memory|--disk) skip=1 ;;
    --name=*) names+=("${a#--name=}") ;;
    -*) ;;
    *) names+=("$a") ;;
  esac
done
# The tools build VM: remember the folder it mounts, and its build.sh writes the images there
# ($STUB_DIR/tools-symlink: a hostile build leaves a symlink instead; tools-hash-symlink: it plants
# FILE.json, a tool image's record, as a symlink to that file).
if [[ ${1:-} == clone && " $* " == *" devvm-tools-build "* ]]; then
  sed -n 's/.*"location": *"\([^"]*\)".*/\1/p' <<<"$*" > "$STUB_DIR/tools-out"
fi
if [[ ${1:-} == shell && " $* " == *" devvm-tools-build bash -s -- "* ]]; then
  args=("$@"); out=$(cat "$STUB_DIR/tools-out")
  for ((i = 0; i < ${#args[@]}; i++)); do [[ ${args[i]} == -- ]] && break; done
  for ((i = i + 3; i < ${#args[@]}; i += 3)); do
    if [[ -f $STUB_DIR/tools-symlink ]]; then ln -s "$STUB_DIR/tools-symlink" "$out/${args[i]}"
    else echo "image ${args[i]}" > "$out/${args[i]}"; fi
    [[ ! -f $STUB_DIR/tools-hash-symlink ]] || ln -s "$STUB_DIR/tools-hash-symlink" "$out/${args[i]}.json"
  done
fi
# The --from build VM's assets/oci/build.sh: it writes what it would in its OUT
# folder (libc: $STUB_DIR/build-libc, else gnu; cmdline:
# $STUB_DIR/build-cmdline). disk.raw has ext4's superblock magic (0xEF53 at
# byte 1080), or is a qcow2 header with $STUB_DIR/build-qcow2. A hostile
# image: "FILE TARGET" lines in $STUB_DIR/build-symlinks replace FILE with
# a symlink.
if [[ ${1:-} == shell && " $* " == *"/oci/build.sh "* ]]; then
  [[ ! -e $STUB_DIR/build-fails ]] || exit 1
  args=("$@")
  for ((i = 0; i < ${#args[@]}; i++)); do [[ ${args[i]} != */oci/build.sh ]] || out=${args[i + 2]}; done
  cat "$STUB_DIR/build-libc" 2>/dev/null > "$out/libc" || echo gnu > "$out/libc"
  cat "$STUB_DIR/build-cmdline" 2>/dev/null > "$out/cmdline" || echo "root=/dev/vda rw console=hvc0" > "$out/cmdline"
  touch "$out/kernel" "$out/initrd"
  if [[ -f $STUB_DIR/build-qcow2 ]]; then printf 'QFI\373' > "$out/disk.raw"
  else { head -c 1080 /dev/zero; printf '\123\357'; } > "$out/disk.raw"; fi
  if [[ -f $STUB_DIR/build-symlinks ]]; then
    while read -r f t; do rm -f "$out/$f"; ln -s "$t" "$out/$f"; done < "$STUB_DIR/build-symlinks"
  fi
  exit 0
fi
# set_config NAME EXPR: a --set's expression, in the forms devvm writes (.KEY = JSON, .KEY=JSON,
# del(.KEY)), into NAME's config: $STUB_DIR/config-<name>/KEY holds KEY's JSON, a.b for a's b.
# The environment goes into the VM's lima.yaml instead, an env: line of its own.
set_config() {
  local d="$STUB_DIR/config-$1" e=$2 k v y
  mkdir -p "$d"
  case $e in
    ".env = "* | "del(.env)")
      y="$LIMA_HOME/$1/lima.yaml"
      mkdir -p "$(dirname "$y")"
      { [[ ! -f $y ]] || grep -v '^env:' "$y" || true
        [[ $e == "del(.env)" ]] || echo "env: ${e#.env = }"; } > "$y.new"
      mv "$y.new" "$y" ;;
    "del(."*")")
      k=${e#del(.}; k=${k%)}
      rm -rf "${d:?}/$k" "$d/$k".* ;;
    .*=*)
      k=${e%%=*}; k=${k% }; k=${k#.}
      v=${e#*=}; v=${v# }
      echo "$v" > "$d/$k" ;;
  esac
}
# config_json NAME: NAME's config as list --json shows it, with lima.yaml's env.
config_json() {
  local d="$STUB_DIR/config-$1" out="" sub f k p ev
  for f in "$d"/*; do
    [[ -e $f ]] || continue
    k=${f##*/}
    [[ $k != *.* ]] || continue
    out+=",\"$k\":$(cat "$f")"
  done
  for p in ssh hostResolver; do
    sub=""
    for f in "$d/$p".*; do
      if [[ -e $f ]]; then sub+=",\"${f##*/"$p".}\":$(cat "$f")"; fi
    done
    [[ -z $sub ]] || out+=",\"$p\":{${sub#,}}"
  done
  ev=$(sed -n 's/^env: //p' "$LIMA_HOME/$1/lima.yaml" 2>/dev/null || true)
  [[ -z $ev ]] || out+=",\"env\":$ev"
  echo "{${out#,}}"
}
# create, clone and edit: a clone starts with its source's config, size and lima.yaml;
# --mount-none drops the mounts, then each --set applies, as Lima's do; create's
# --cpus=N and --memory=GiB set its size.
case ${1:-} in
  create | clone | edit)
    target=${names[0]:-}
    if [[ $1 == clone ]]; then
      target=${names[1]:-}
      rm -rf "${STUB_DIR:?}/config-$target"
      [[ ! -d $STUB_DIR/config-${names[0]} ]] || cp -R "$STUB_DIR/config-${names[0]}" "$STUB_DIR/config-$target"
      [[ ! -f $STUB_DIR/size-${names[0]} ]] || cp "$STUB_DIR/size-${names[0]}" "$STUB_DIR/size-$target"
      if [[ -f $LIMA_HOME/${names[0]}/lima.yaml ]]; then
        mkdir -p "$LIMA_HOME/$target"
        cp "$LIMA_HOME/${names[0]}/lima.yaml" "$LIMA_HOME/$target/lima.yaml"
      fi
    fi
    [[ " $* " != *" --mount-none "* ]] || rm -f "$STUB_DIR/config-$target/mounts"
    args=("$@")
    cpus=4 mem=8589934592
    for ((i = 0; i < ${#args[@]}; i++)); do
      case ${args[i]} in
        --set) set_config "$target" "${args[i + 1]}" ;;
        --cpus=*) cpus=${args[i]#--cpus=} ;;
        --memory=*) mem=$(awk -v g="${args[i]#--memory=}" 'BEGIN { printf "%.0f", g * 1073741824 }') ;;
      esac
    done
    [[ $1 != create ]] || echo "$cpus $mem 107374182400" > "$STUB_DIR/size-$target" ;;
esac
case ${1:-} in
  create)
    for n in "${names[@]+"${names[@]}"}"; do [[ -f $n ]] || set_status "$n" Stopped; done
    [[ ${!#} != - ]] || cat > "$STUB_DIR/create-template" ;;
  clone)
    set_status "${names[1]}" Stopped
    [[ ! -e $STUB_DIR/clone-fails ]] || exit 1 ;;
  start)
    [[ ! -e $STUB_DIR/start-hangs ]] || { : > "$STUB_DIR/hanging"; exec sleep 30; }
    set_status "${names[0]}" Running
    mkdir -p "$LIMA_HOME/${names[0]}"
    ha=$PPID
    [[ ! -f $STUB_DIR/hostagent ]] || ha=$(cat "$STUB_DIR/hostagent")
    echo "$ha" > "$LIMA_HOME/${names[0]}/ha.pid"
    if [[ -e $STUB_DIR/start-hangs-running && ${names[0]} == *"$(cat "$STUB_DIR/start-hangs-running")"* ]]; then
      : > "$STUB_DIR/hanging"
      exec sleep 30
    fi
    echo "${SSH_AUTH_SOCK-unset}" > "$STUB_DIR/start-agent-${names[0]}"
    cfg="$LIMA_HOME/${names[0]}/ssh.config"
    [[ -f $cfg ]] || printf 'Host lima-%s\n  IdentityFile "%s/_config/user"\n  StrictHostKeyChecking no\n  UserKnownHostsFile /dev/null\n  NoHostAuthenticationForLocalhost yes\n  PreferredAuthentications publickey\n  BatchMode yes\n  IdentitiesOnly yes\n  User stub\n  ControlMaster auto\n  ControlPath "%s/ssh.sock"\n  ControlPersist yes\n  PermitLocalCommand yes\n  LocalCommand touch /x/ran\n  Hostname 127.0.0.1\n  Port 60022\n' \
      "${names[0]}" "$LIMA_HOME" "$LIMA_HOME/${names[0]}" > "$cfg"
    [[ ! -e $STUB_DIR/start-fails ]] || exit 1 ;;
  stop) set_status "${names[0]}" Stopped ;;
  edit)
    # --cpus N, --memory GiB and --disk GiB change the VM's size.
    read -r cpus mem disk < <(cat "$STUB_DIR/size-${names[0]}" 2>/dev/null || echo "4 8589934592 107374182400")
    args=("$@")
    for ((i = 0; i < ${#args[@]} - 1; i++)); do
      v=${args[i + 1]}
      case ${args[i]} in
        --cpus) cpus=$v ;;
        --memory) mem=$(awk -v g="$v" 'BEGIN { printf "%.0f", g * 1073741824 }') ;;
        --disk) disk=$(awk -v g="$v" 'BEGIN { printf "%.0f", g * 1073741824 }') ;;
      esac
    done
    echo "$cpus $mem $disk" > "$STUB_DIR/size-${names[0]}" ;;
  delete)
    for n in "${names[@]}"; do set_status "$n"; rm -rf "${STUB_DIR:?}/config-$n" "$STUB_DIR/size-$n" "${LIMA_HOME:?}/$n"; done
    [[ ! -e $STUB_DIR/delete-fails ]] || exit 1 ;;
  rename)
    # OLD NEW: a stopped instance, its config, size and folder, under its new name.
    [[ ! -e $STUB_DIR/rename-fails ]] || exit 1
    old=${names[0]} new=${names[1]}
    grep -qxE "$old( Stopped)?" "$inst" || { echo "limactl stub: $old isn't there, stopped" >&2; exit 1; }
    ! grep -q "^$new\( \|$\)" "$inst" || { echo "limactl stub: $new exists" >&2; exit 1; }
    set_status "$old"
    set_status "$new" Stopped
    for f in config size; do
      [[ ! -e $STUB_DIR/$f-$old ]] || mv "$STUB_DIR/$f-$old" "$STUB_DIR/$f-$new"
    done
    [[ ! -d $LIMA_HOME/$old ]] || mv "$LIMA_HOME/$old" "$LIMA_HOME/$new" ;;
  shell)
    echo "${SSH_AUTH_SOCK-unset}" > "$STUB_DIR/shell-agent"
    # A clone's git: Exec's command line is "cd '/' && exec WORDS".
    line=${*: -1}
    if [[ $line == "cd '/' && exec 'git' '-C' "* || ($line == "cd '/' && exec 'sh' '-c' "* && ($line == *receive.denyCurrentBranch* || $line == *"status --porcelain"*)) ]]; then
      [[ ! -e $STUB_DIR/shell-fails ]] || exit 1
      eval "set -- ${line#"cd '/' && exec "}"
      # git worktree list: its paths as the VM's, without vmfs.
      if [[ $1 == git && $4 == worktree && $5 == list ]]; then
        vmfs="$(cd "$STUB_DIR" && pwd -P)/vmfs"
        git -C "$STUB_DIR/vmfs$3" "${@:4}" | while IFS= read -r -d '' l; do printf '%s\0' "${l/#"worktree $vmfs"/worktree }"; done
        exit "${PIPESTATUS[0]}"
      fi
      if [[ $1 == git ]]; then exec git -C "$STUB_DIR/vmfs$3" "${@:4}"; fi
      sudo() { "$@"; }
      export -f sudo
      exec bash -c "$3" "$4" "$STUB_DIR/vmfs$5" "${@:6}"
    fi
    # A script fed to bash -s: its first line after the shebang.
    if [[ ${*: -2} == "bash -s" || "$*" == *"exec 'bash' '-s'" ]]; then "${0%/*}/stub-log" "$STUB_DIR/scripts" "$(sed -n 2p)"; fi
    # A VM's home folder as a remake reads it: $STUB_DIR/vmhome-<name>'s files
    # (none when it's missing); what a remake puts in a new disk's home is kept
    # as $STUB_DIR/home-in.tgz. Either fails with shell-fails-on's text.
    if [[ "$*" == *"tar -czf - --one-file-system"* || "$*" == *"tar -xzf - --skip-old-files"* ]]; then
      [[ ! -f $STUB_DIR/shell-fails-on || "$*" != *"$(cat "$STUB_DIR/shell-fails-on")"* ]] || exit 1
    fi
    if [[ "$*" == *"tar -czf - --one-file-system"* ]]; then
      mkdir -p "$STUB_DIR/vmhome-${names[0]}"
      # macOS's tar adds AppleDouble ._ files, which a VM's GNU tar never has.
      COPYFILE_DISABLE=1 exec tar -czf - -C "$STUB_DIR/vmhome-${names[0]}" .
    fi
    if [[ "$*" == *"tar -xzf - --skip-old-files"* ]]; then
      cat > "$STUB_DIR/home-in.tgz"
      exit 0
    fi
    # A VM's setup: what it was sent.
    if [[ "$*" == *"tar -xf - "* ]]; then
      cat > "$STUB_DIR/sync.tar"
      [[ ! -f $STUB_DIR/sync-fails-with ]] || exit 1
    fi
    if [[ "$*" == *"/run/devvm/tools-unmounted"* ]]; then
      [[ -f $STUB_DIR/sync-fails-with ]] || exit 1
      exec cat "$STUB_DIR/sync-fails-with"
    fi
    # A direct connection from the VM, past its proxy: it fails, as a
    # confined VM's does, unless $STUB_DIR/net-direct exists.
    if [[ "$*" == *"'curl' '--noproxy'"* ]]; then [[ -e $STUB_DIR/net-direct ]] || exit 7; fi
    # The VM's ssh host keys.
    if [[ "$*" == *"/etc/ssh/ssh_host_"* ]]; then
      [[ ! -e $STUB_DIR/hostkeys-fail ]] || exit 1
      echo "ssh-ed25519 AAAAstubkey${names[0]//-/} root@${names[0]}"
      echo "not a key"
      exit 0
    fi
    [[ ! -e $STUB_DIR/shell-fails ]] || exit 1
    [[ ! -f $STUB_DIR/shell-fails-on || "$*" != *"$(cat "$STUB_DIR/shell-fails-on")"* ]] || exit 1
    [[ ! -e $STUB_DIR/shell-hangs ]] || { : > "$STUB_DIR/hanging"; exec sleep 30; } ;;
esac

[[ ${1:-} != --version ]] || { echo "limactl version 2.2.1"; exit 0; }
[[ ${1:-} == list && ${2:-} == --json ]] || exit 0
[[ ! -e $STUB_DIR/list-fails ]] || exit 1
[[ ! -e $STUB_DIR/list-hangs ]] || exec sleep 30
# Sorted by name, as Lima lists its instances.
while read -r n st; do
  read -r cpus mem disk < <(cat "$STUB_DIR/size-$n" 2>/dev/null || echo "4 8589934592 107374182400")
  printf '{"name":"%s","status":"%s","dir":"%s","cpus":%s,"memory":%s,"disk":%s,"sshLocalPort":60022,"sshConfigFile":"%s","config":%s}\n' \
    "$n" "${st:-Stopped}" "$LIMA_HOME/$n" "$cpus" "$mem" "$disk" "$LIMA_HOME/$n/ssh.config" "$(config_json "$n")"
done < <(LC_ALL=C sort "$inst")
