#!/bin/bash
# Stand-in for docker in tests, for --from's images only Docker has. Logs every call to $STUB_LOG.
# `info` and `image inspect` fail when $STUB_DIR/docker-down exists. `image inspect --format {{.Id}}
# REF` finds an image only when $STUB_DIR/docker-image exists, and prints it (its ID). `save -o F
# REF` writes a tarball whose manifest.json names that
# image's config ($STUB_DIR/docker-saved instead, if it exists: the tag moved meanwhile). Anything
# else fails.
set -euo pipefail
"${0%/*}/stub-log" "$STUB_LOG" docker "$@"
case "${1:-} ${2:-}" in
  "info "*)
    [[ ! -e "$STUB_DIR/docker-down" ]] || { echo "failed to connect to the docker API" >&2; exit 1; }
    exit 0 ;;
  "image inspect")
    [[ ! -e "$STUB_DIR/docker-down" ]] || { echo "failed to connect to the docker API" >&2; exit 1; }
    [[ ${3:-} == --format && ${4:-} == '{{.Id}}' ]] || { echo "docker stub: image inspect $*" >&2; exit 2; }
    [[ -f "$STUB_DIR/docker-image" ]] || { echo "Error response from daemon: No such image: ${5:-}" >&2; exit 1; }
    cat "$STUB_DIR/docker-image"
    exit 0 ;;
  "save -o")
    id=$(cat "$STUB_DIR/docker-saved" 2>/dev/null || cat "$STUB_DIR/docker-image")
    d=$(mktemp -d)
    printf '[{"Config":"blobs/sha256/%s","RepoTags":["%s"],"Layers":[]}]' "${id#sha256:}" "$4" > "$d/manifest.json"
    tar -cf "$3" -C "$d" manifest.json
    rm -rf "$d"
    exit 0 ;;
esac
echo "docker stub: $*" >&2
exit 2
