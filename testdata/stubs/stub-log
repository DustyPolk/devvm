#!/bin/bash
# For the other stubs, which run it from their own folder: stub-log FILE WORD... appends the words,
# joined by spaces, as one line to FILE (the call log, $STUB_LOG, or a stub's own list), in a single
# write. Lines from stubs running at once never mix, as each write to a file opened for appending
# lands whole, where a shell's echo or printf can write a long line in pieces. Perl makes that one
# write, reading the line on its input: the words stay off perl's command line, because an endpoint
# security tool (CrowdStrike Falcon) kills a perl whose arguments hold an ssh option and a proxy URL
# with a password, as a start's limactl edit does.
set -euo pipefail
[[ $# -ge 1 ]] || { echo "usage: stub-log FILE WORD..." >&2; exit 2; }
file=$1
shift
IFS=' '
# shellcheck disable=SC2016 # perl's own variables
printf '%s\n' "$*" | perl -e '
  use strict;
  use warnings;
  my $file = shift @ARGV;
  my $line = do { local $/; <STDIN> };
  open(my $f, ">>", $file) or die "stub-log: $file: $!\n";
  my $n = syswrite($f, $line);
  die "stub-log: $file: $!\n" unless defined $n;
  die "stub-log: $file: wrote $n of " . length($line) . " bytes\n" unless $n == length $line;
  close($f) or die "stub-log: $file: $!\n";
' "$file"
