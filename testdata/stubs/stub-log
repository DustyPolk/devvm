#!/usr/bin/env perl
# For the other stubs, which run it from their own folder: stub-log FILE WORD... appends the words,
# joined by spaces, as one line to FILE (the call log, $STUB_LOG, or a stub's own list), in a single
# write. Lines from stubs running at once never mix, as each write to a file opened for appending
# lands whole, where a shell's echo or printf can write a long line in pieces.
use strict;
use warnings;

my $file = shift @ARGV;
die "usage: stub-log FILE WORD...\n" unless defined $file;
my $line = join(' ', @ARGV) . "\n";
open(my $f, '>>', $file) or die "stub-log: $file: $!\n";
my $n = syswrite($f, $line);
die "stub-log: $file: $!\n" unless defined $n;
die "stub-log: $file: wrote $n of " . length($line) . " bytes\n" unless $n == length $line;
close($f) or die "stub-log: $file: $!\n";
