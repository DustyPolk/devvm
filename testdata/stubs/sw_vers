#!/bin/sh
# Stand-in for macOS sw_vers in tests: -productVersion prints $STUB_SW_VERS when set.
# Anything else runs the real sw_vers.
if [ "${1:-}" = -productVersion ] && [ -n "${STUB_SW_VERS:-}" ]; then
  echo "$STUB_SW_VERS"
  exit 0
fi
[ ! -x /usr/bin/sw_vers ] || exec /usr/bin/sw_vers "$@"
echo "sw_vers: not found" >&2
exit 127
