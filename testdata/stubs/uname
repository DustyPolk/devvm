#!/bin/sh
# Stand-in for uname in tests: -s prints $STUB_UNAME_S and -m prints $STUB_UNAME_M when set.
# Anything else runs the real uname.
case ${1:-} in
  -s) [ -z "${STUB_UNAME_S:-}" ] || { echo "$STUB_UNAME_S"; exit 0; } ;;
  -m) [ -z "${STUB_UNAME_M:-}" ] || { echo "$STUB_UNAME_M"; exit 0; } ;;
esac
for d in /usr/bin /bin; do
  [ ! -x "$d/uname" ] || exec "$d/uname" "$@"
done
echo "uname: not found" >&2
exit 127
