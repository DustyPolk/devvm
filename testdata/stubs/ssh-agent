#!/bin/bash
# Stand-in for ssh-agent in tests: logs every call to $STUB_LOG, and with -a
# SOCKET "runs" an agent there: $STUB_DIR/agent-up holds its socket, and
# $STUB_DIR/agent-held the keys it holds (see the ssh-add stub).
set -euo pipefail
echo "ssh-agent $*" >> "$STUB_LOG"
[[ ${1:-} == -a && -n ${2:-} ]] || exit 1
echo "$2" > "$STUB_DIR/agent-up"
: > "$STUB_DIR/agent-held"
