#!/bin/bash
# Stand-in for qemu-img in tests: logs every call to $STUB_LOG; info says
# the disk is qcow2 (as JSON, backed by the file named in
# $STUB_DIR/backing-<instance>, if any), create makes the file.
set -euo pipefail
"${0%/*}/stub-log" "$STUB_LOG" qemu-img "$@"
case ${1:-} in
  info)   b=$STUB_DIR/backing-$(basename "$(dirname "${*: -1}")")
          if [[ -f $b ]]; then printf '{"format":"qcow2","backing-filename":"%s"}\n' "$(cat "$b")"
          else echo '{"format":"qcow2"}'; fi ;;
  create) touch "${*: -1}" ;;
esac
