#!/bin/bash
# Stand-in for macOS security in tests, so they never touch the real
# Keychain: logs the call to $STUB_LOG (stdin isn't logged, as a value
# there is in no process's arguments). An item is the file
# $STUB_DIR/keychain/ACCOUNT. find-generic-password -a NAME … -w prints it,
# delete-generic-password -a NAME deletes it, each failing as security does
# for an item that isn't there (44); security -i reads
# add-generic-password … -a NAME … -w "VALUE" lines from stdin and saves
# them.
set -euo pipefail
"${0%/*}/stub-log" "$STUB_LOG" security "$@"
kc=$STUB_DIR/keychain
account=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do [[ ${args[i]} != -a ]] || account=${args[i + 1]:-}; done
case ${1:-} in
  find-generic-password)
    [[ -n $account && -f $kc/$account ]] || exit 44
    cat "$kc/$account" ;;
  delete-generic-password)
    [[ -n $account && -f $kc/$account ]] || exit 44
    rm "$kc/$account" ;;
  -i)
    re='^add-generic-password .*-a "([^"]*)" .*-w "([^"]*)"$'
    while IFS= read -r line; do
      [[ $line =~ $re ]] || exit 1
      mkdir -p "$kc"
      printf '%s\n' "${BASH_REMATCH[2]}" > "$kc/${BASH_REMATCH[1]}"
    done ;;
  *) exit 1 ;;
esac
