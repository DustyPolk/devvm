#!/bin/bash
# Stand-in for the host's mise in tests (DEVVM_HOST_MISE): `mise lock` writes $MISE_STUB_LOCK as
# ./mise.lock, or $MISE_STUB_OLDER_LOCK for a mise.toml listing versions (the step back's); with
# MISE_STUB_FAIL set, it fails like mise offline. `mise ls-remote` prints $MISE_STUB_VERSIONS.
set -euo pipefail
"${0%/*}/stub-log" "${STUB_LOG:-/dev/null}" mise "$@"
# shellcheck disable=SC2086  # one version per word
case ${1:-} in
  ls-remote) printf '%s\n' ${MISE_STUB_VERSIONS:-}; exit 0 ;;
  lock) ;;
  *) exit 0 ;;
esac
[[ -z ${MISE_STUB_FAIL:-} ]] || { echo "mise ERROR failed to fetch versions: offline" >&2; exit 1; }
if grep -q '= \[' mise.toml 2>/dev/null; then cp "$MISE_STUB_OLDER_LOCK" mise.lock
else cp "$MISE_STUB_LOCK" mise.lock; fi
