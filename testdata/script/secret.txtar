# devvm secret: the secrets kept on this machine, listed bare. The
# Keychain is the stub's on macOS (service DEVVM_SECRET_SERVICE), a file
# elsewhere. Every value here is fake.
env DEVVM_MESSAGES=names
env VMS=$XDG_DATA_HOME/devvm/vms
env RUN=$XDG_DATA_HOME/devvm/run
exec devvm --help
stdout '^  secret '
! stdout '^  auth '
! stdout '  get '
! exec devvm auth claude
stderr '^devvm: args_too_many args=\[IMAGE\] command=devvm given=auth claude$'

# get NAME: a value for a VM's proxy, never to a terminal.
! exec devvm secret get github
stderr '^devvm: no_secret secret=github$'
[darwin] mkdir $STUB_DIR/keychain
[darwin] exec sh -c 'echo ghp_testfake > "$STUB_DIR/keychain/github"'
[!darwin] mkdir $XDG_CONFIG_HOME/devvm/secrets
[!darwin] exec sh -c 'echo ghp_testfake > "$XDG_CONFIG_HOME/devvm/secrets/github"'
exec devvm secret get github
stdout '^ghp_testfake$'
[darwin] stub_calls
[darwin] stdout '^security find-generic-password -s devvm-test -a github -w$'

# A claude token in devvm's environment wins.
! exec devvm secret get claude
stderr '^devvm: no_secret secret=claude$'
env CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-testfake
exec devvm secret get claude
stdout '^sk-ant-oat01-testfake$'
exec devvm secret
stdout '^NAME +SAVED +USED BY$'
stdout '^claude +yes +-$'
env CLAUDE_CODE_OAUTH_TOKEN=

# Only devvm's own names: never a path.
! exec devvm secret get ../../etc/passwd
stderr '^devvm: no_secret secret=\.\./\.\./etc/passwd$'
! exec devvm secret set ../../etc/passwd --stdin
stderr '^devvm: arg_not_choice choices=claude, github command=devvm secret set given=\.\./\.\./etc/passwd$'
! exec devvm secret rm nope
stderr '^devvm: arg_not_choice choices=claude, github command=devvm secret rm given=nope$'
[darwin] env DEVVM_SECRET_SERVICE='x -a y'
[darwin] ! exec devvm secret get github
[darwin] stderr '^devvm: bad_secret_service$'
[darwin] stdin claude.token
[darwin] ! exec devvm secret set claude --stdin
[darwin] stderr '^devvm: bad_secret_service$'
env DEVVM_SECRET_SERVICE=devvm-test

# A login's value comes from its file, through the login helper.
mkdir $HOME/.codex
cp codex.json $HOME/.codex/auth.json
exec devvm secret get codex-key
stdout '^sk-testfake-codex$'

# set and rm; ls lists every secret, whether saved, and its VMs. A value
# goes in through stdin, never in a process's arguments.
exec sh -c ': > "$STUB_LOG"'
stdin github.token
exec devvm secret set github --stdin
[darwin] stdout '^==> secret_saved_keychain secret=github$'
[!darwin] stdout '^==> secret_saved file=\S*/config/devvm/secrets/github secret=github$'
exec devvm secret get github
stdout '^ghp_testfake2$'
stub_calls
! stdout ghp_testfake2
[darwin] stdout '^security -i$'
[!darwin] exec sh -c 'stat -c %a "$XDG_CONFIG_HOME/devvm/secrets" "$XDG_CONFIG_HOME/devvm/secrets/github"'
[!darwin] stdout '^700\n600\n$'
exec devvm secret
stdout '^claude +no +-$'
stdout '^github +yes +-$'
exec devvm secret rm github
stdout '^==> secret_removed secret=github$'
! exec devvm secret get github
stderr '^devvm: no_secret secret=github$'
! exec devvm secret rm github
stderr '^devvm: no_secret secret=github$'

# Tokens that are refused: nothing saved.
stdin empty.token
! exec devvm secret set github --stdin
stderr '^devvm: no_token$'
stdin quotes.token
! exec devvm secret set github --stdin
stderr '^devvm: token_quotes$'
stdin browser.token
! exec devvm secret set claude
stderr '^devvm: not_setup_token$'
! exec devvm secret get github
! exec devvm secret get claude

# devvm secret set claude without a terminal reads a line, and asks
# nothing.
stdin claude.token
exec devvm secret set claude
[darwin] stdout '^==> secret_saved_keychain secret=claude$'
! stderr .
exec devvm secret get claude
stdout '^sk-ant-oat01-testfake$'
! exec devvm secret set codex
stderr '^devvm: arg_not_choice choices=claude, github command=devvm secret set given=codex$'
! exec devvm secret ls
stderr '^devvm: no_subcommand command=devvm secret commands=rm, set, unuse, use given=ls$'

# use and unuse bind a token to the folder's VM. One without network
# policy got the token itself: unbinding says it still works.
mkdir $WORK/off
cd $WORK/off
! exec devvm secret use github
stderr '^devvm: no_vm dir=\S*/off$'
exec devvm --no-network-policy --no-git-protect base
exec devvm secret use github
stdout '^==> secret_used secret=github vm=devvm-off-[0-9a-f]{14}$'
stderr '^devvm: no_github_token vm=devvm-off-[0-9a-f]{14}$'
exec sh -c 'cat "$VMS"/devvm-off-*'
stdout '^secrets=github$'
exec devvm secret
stdout '^github +no +devvm-off-[0-9a-f]{14}$'
exec devvm secret unuse github
stdout '^==> secret_unused secret=github vm=devvm-off-[0-9a-f]{14}$'
stderr '^secret_unuse_copied secret=github vm=devvm-off-[0-9a-f]{14}$'
exec sh -c 'cat "$VMS"/devvm-off-*'
stdout '^secrets=$'
! exec devvm secret unuse nope
stderr '^devvm: arg_not_choice choices=claude, github command=devvm secret unuse given=nope$'

# With network policy the VM's proxy gets the binding at once, and a
# token saved or removed later too; never the value.
mkdir $WORK/net
cd $WORK/net
exec devvm --network-policy --no-git-protect base
exec sh -c 'cat "$RUN"/devvm-net-*.secrets.json'
stdout '^\[\]$'
exec devvm secret use github
stderr '^devvm: no_github_token '
exec sh -c 'cat "$RUN"/devvm-net-*.secrets.json'
stdout '^\[\]$'
stdin $WORK/github.token
exec devvm secret set github --stdin
exec sh -c 'cat "$RUN"/devvm-net-*.secrets.json'
stdout '"name":"github","hosts":\["api.github.com","github.com","codeload.github.com","raw.githubusercontent.com"\],"header":"Authorization","placeholder":"devvm-proxy-managed-github-[0-9a-f]{32}"'
! stdout ghp_testfake2
exec sh -c 'cat "$RUN"/devvm-net-*.secrets.policy'
stdout '^api.github.com:443$'
exec devvm secret unuse github
! stderr secret_unuse_copied
exec sh -c 'cat "$RUN"/devvm-net-*.secrets.json'
stdout '^\[\]$'
exec devvm secret use github
exec devvm secret rm github
exec sh -c 'cat "$RUN"/devvm-net-*.secrets.json'
stdout '^\[\]$'

-- codex.json --
{"OPENAI_API_KEY":"sk-testfake-codex","last_refresh":null}
-- github.token --
 ghp_testfake2
-- claude.token --
sk-ant-oat01-testfake
-- empty.token --

-- quotes.token --
ghp_x" -A -T "
-- browser.token --
some-browser-code
