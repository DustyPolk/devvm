# A backend a VM uses that can't list its images: gc warns, leaves
# everything of that backend's alone (its images, its shared tool images
# and those without a record naming their backend, its VMs' leftovers),
# and succeeds. devvm images still fails.
env SHARE=$XDG_DATA_HOME/devvm/tools

# foo on Lima, made stale.
mkdir $XDG_CONFIG_HOME/devvm/layers
cp foo.sh $XDG_CONFIG_HOME/devvm/layers/foo.sh
exec devvm build foo
exec sh -c 'echo "# edited" >> "$XDG_CONFIG_HOME/devvm/layers/foo.sh"'

# Unused tool images: one recorded as Lima's, one nobody can tell;
# claude's build, for a VM that's gone since, makes the lock, so they're
# unused.
project ag
exec devvm --tools none --agents claude --no-network-policy --no-git-protect
exec devvm rm --force --no-export
exec sh -c 'cd "$SHARE" && for v in 1.2.0 1.3.0; do echo x > go-$v-0123456789ab.erofs; done'
json_set $SHARE/go-1.2.0-0123456789ab.erofs.json sha256=x libc=gnu backend=lima built=2020-01-01T00:00:00Z

# A Lima VM that's gone, so Lima is used; then Lima stops answering.
mkdir $VMS/12345612345612
json_set $VMS/12345612345612/vm.json version:=1 id=x name=devvm-gone-12345612345612 image=base dir=/p/gone backend=lima created=2020-01-01T00:00:00Z net.on:=false
exec touch -t 202001010000 $VMS/12345612345612/vm.json
exec sh -c 'touch "$STUB_DIR/list-fails"'

exec devvm gc --force --orphans
stderr '^devvm: gc_backend_skipped backend=lima$'
stderr '^gc_orphans_unknown backend=lima$'
! stderr gc_failed
! stdout '^gc_image '
! stdout '^gc_orphan'
exists $VMS/12345612345612/vm.json
exists $SHARE/go-1.2.0-0123456789ab.erofs
exists $SHARE/go-1.3.0-0123456789ab.erofs

# devvm images lists every backend's or none.
! exec devvm images
stderr '^devvm: images_failed '

-- foo.sh --
#!/bin/bash
echo foo
