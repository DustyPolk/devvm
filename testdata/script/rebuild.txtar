# devvm rebuild: a new key for the image (its rebuild counter), built from
# its parent as it is; then the stale images go, the old one and those
# built on it among them, and nothing else.
env IMAGES=$XDG_DATA_HOME/devvm/images
mkdir $XDG_CONFIG_HOME/devvm/layers
cp foo.sh $XDG_CONFIG_HOME/devvm/layers/foo.sh
cp bar.sh $XDG_CONFIG_HOME/devvm/layers/bar.sh
exec devvm build foo+bar
exec stub vm devvm-web-12345612345612 Stopped
exec sh -c 'for i in base foo foo+bar; do grep -lxF "  \"name\": \"$i\"," "$IMAGES"/*/record.json | xargs dirname | xargs basename > "$i.key"; done'
stub_reset

# Not a terminal: it says what goes, and refuses unless --force, which
# goes ahead.
! exec devvm rebuild base+foo
stdout '^rebuild_replaces above=foo\+bar image=foo$'
stderr '^devvm: force_needed command=devvm rebuild$'
! stdout building_image
exec devvm rebuild --force base+foo
stdout '^rebuild_replaces above=foo\+bar image=foo$'
stdout '^==> building_image image=foo key=[0-9a-f]{12}$'
! stdout 'image=base'
stdout -count=2 '^==> deleted_old_image image=foo(\+bar)? key=[0-9a-f]{12}$'
grep '\{\n      "backend": "lima",\n      "from": "",\n      "name": "foo",\n      "counter": "\d{14}-[0-9a-f]{8}"\n    \}' $IMAGES/rebuilds.json
stub_calls
stdout '^limactl clone --tty=false --mount-none devvm-img-[0-9a-f]{12} devvm-img-[0-9a-f]{12}$'
exec sh -c '{ echo "limactl delete -f devvm-img-$(cat foo.key)"; echo "limactl delete -f devvm-img-$(cat foo+bar.key)"; } | sort'
cp stdout want-deleted
exec sh -c 'grep "^limactl delete" "$STUB_LOG" | sort'
cmp stdout want-deleted

# What's left: base, the new foo and the project VM. foo+bar builds again
# when it's next needed.
exec sh -c 'stub vms | grep -c .'
stdout '^3$'
exec sh -c 'v=$WORK/vms; stub vms > "$v" && grep -q "^devvm-img-$(cat base.key) " "$v" && grep -q "^devvm-web-12345612345612" "$v"'
exec sh -c 'test -f "$IMAGES/$(cat base.key)/record.json" && ! test -e "$IMAGES/$(cat foo.key)" && ! test -e "$IMAGES/$(cat foo+bar.key)"'

# Nothing built on it: nothing to ask.
exec devvm rebuild foo
! stdout rebuild_replaces
stdout -count=1 '^==> deleted_old_image image=foo key=[0-9a-f]{12}$'

# A rebuild changes the base as given alone: the base from Ubuntu's
# cloud image stays current, and so is kept, after a --from base is
# rebuilt, and so does a base from ubuntu-26.04, whose counter a name made
# of ubuntu:26.04 would once have been. Registries are never reached: a
# pinned digest needs no lookup.
env PIN=ubuntu:26.04@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
env PIN2=ubuntu-26.04@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
env HTTPS_PROXY=http://127.0.0.1:9
env https_proxy=http://127.0.0.1:9
exec devvm --from $PIN build base
exec devvm --from $PIN2 build base
exec devvm images
stdout -count=3 '^base +.* current +\S+$'
exec devvm rebuild --from $PIN --force base
stdout -count=1 '^==> deleted_old_image image=base key=[0-9a-f]{12}$'
exec devvm images
stdout -count=1 '^base +ubuntu 26\.04 \(\d{8}\) .* current +\S+$'
stdout -count=3 '^base +.* current +\S+$'
! stdout ' stale '
grep '"backend": "lima",\n      "from": "ubuntu:26.04@sha256:a{64}",\n      "name": "base",' $IMAGES/rebuilds.json
! grep '"from": "ubuntu-26.04' $IMAGES/rebuilds.json

-- foo.sh --
#!/bin/bash
echo foo
-- bar.sh --
#!/bin/bash
echo bar
