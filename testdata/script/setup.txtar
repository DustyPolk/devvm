# setup: the default backend, base's features and new VMs' size (all
# asked in a terminal, which Go tests cover; without one, the backend and
# size aren't asked and the features are kept, or every one until they're
# chosen; --backend, --features, --cpus and --memory without asking). A new choice of features says base
# rebuilds, and once images are built that devvm gc deletes the old ones.
env DEVVM_MESSAGES=names
env CHOSEN=$XDG_CONFIG_HOME/devvm/base-features

# Kept: none chosen; no backend or size asked.
exec devvm setup
stdout '^==> base_features_none$'
! stdout base_will_rebuild
! stdout default_backend
! stdout 'size_question|size_defaults'
! exists $XDG_CONFIG_HOME/devvm/backend
! exists $XDG_CONFIG_HOME/devvm/size
! stderr .
! stub_calls

# Unchosen: every feature.
rm $CHOSEN
exec devvm setup
stdout '^==> base_features features=cli-tools fzf omb$'
! stdout base_will_rebuild

# --features, in the order features run; nothing built yet.
exec devvm setup --features omb,fzf
stdout '^==> base_features features=fzf omb$'
stdout '^==> base_will_rebuild$'
! stdout gc_old_hint
! stdout default_backend
cmp $CHOSEN fzf-omb
exec devvm setup --features fzf,omb
! stdout base_will_rebuild

# Built: a new choice rebuilds base, and gc deletes the old one.
exec devvm build base
exec devvm setup --features ''
stdout '^==> base_features_none$'
stdout '^==> base_will_rebuild$'
stdout '^gc_old_hint$'
exec devvm build base
stdout '^==> building_image image=base key='
exec devvm gc
stdout '^gc_image image=base key='

# A name that isn't a feature changes nothing.
! exec devvm setup --features fzf,nope
stderr '^devvm: no_feature feature=nope features=cli-tools fzf omb$'
! stdout base_features
exec devvm setup
stdout '^==> base_features_none$'

# The default backend: only it, unless --features is given too.
exec devvm setup --backend lima
stdout '^==> default_backend backend=lima$'
! stdout base_features
cmp $XDG_CONFIG_HOME/devvm/backend lima.txt
exec devvm setup --backend lima --features fzf
stdout '^==> default_backend backend=lima$'
stdout '^==> base_features features=fzf$'
! exec devvm setup --backend nope
stderr '^devvm: backend_unknown backends=docker, lima, smolvm name=nope$'
cmp $XDG_CONFIG_HOME/devvm/backend lima.txt

# New VMs' size: --cpus and --memory, checked, without asking; with only
# them the backend and features stay, and a saved disk is kept.
exec sh -c 'echo disk=120 > "$XDG_CONFIG_HOME/devvm/size"'
exec devvm setup --cpus 2 --memory 4GiB
stdout '^==> size_defaults size=cpus=2 memory=4GiB disk=120GiB$'
! stdout 'base_features|default_backend|size_question'
cmp $XDG_CONFIG_HOME/devvm/size size.txt
exec devvm setup --memory 3
stdout '^==> size_defaults size=cpus=2 memory=3GiB disk=120GiB$'
cmp $XDG_CONFIG_HOME/devvm/size size3.txt
! exec devvm setup --cpus 9999
stderr '^devvm: too_many_cpus have=[0-9]+ want=9999$'
! exec devvm setup --memory 99999
stderr '^devvm: too_much_memory have=[0-9]+ max=[0-9.]+ want=99999$'
! exec devvm setup --cpus 1.5
stderr '^devvm: cpus_not_number value="1\.5"$'
cmp $XDG_CONFIG_HOME/devvm/size size3.txt
exec devvm setup --backend lima --cpus 4
stdout '^==> default_backend backend=lima$'
stdout '^==> size_defaults size=cpus=4 memory=3GiB disk=120GiB$'
! stdout base_features

# An unreadable choice stays for you to fix.
cp bad $CHOSEN
! exec devvm setup
stderr '^devvm: setup_failed reason=.*base-features'
cmp $CHOSEN bad

-- fzf-omb --
fzf
omb
-- lima.txt --
lima
-- size.txt --
cpus=2
memory=4
disk=120
-- size3.txt --
cpus=2
memory=3
disk=120
-- bad --
Not_A_Feature
