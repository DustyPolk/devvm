# setup: the default backend, base's features, and new VMs' size and
# network policy (all asked in a terminal, which Go tests cover; without
# one, the backend, size and network policy aren't asked and the features
# are kept, or every one until they're chosen; --backend and --features
# without asking). A new choice of features says base rebuilds, and once
# images are built that devvm gc deletes the old ones.
env CHOSEN=$XDG_CONFIG_HOME/devvm/base-features

# Kept: none chosen; no backend or size asked.
exec devvm setup
stdout '^==> base_features_none$'
! stdout base_will_rebuild
! stdout default_backend
! stdout 'size_question|size_defaults'
! exists $XDG_CONFIG_HOME/devvm/backend
! exists $XDG_CONFIG_HOME/devvm/size
! stderr .
! stub_calls

# Unchosen: every feature.
rm $CHOSEN
exec devvm setup
stdout '^==> base_features features=cli-tools fzf omb$'
! stdout base_will_rebuild

# --features, in the order features run; nothing built yet.
exec devvm setup --features omb,fzf
stdout '^==> base_features features=fzf omb$'
stdout '^==> base_will_rebuild$'
! stdout gc_old_hint
! stdout default_backend
cmp $CHOSEN fzf-omb
exec devvm setup --features fzf,omb
! stdout base_will_rebuild

# Built: a new choice rebuilds base, and gc deletes the old one.
exec devvm build base
exec devvm setup --features none
stdout '^==> base_features_none$'
stdout '^==> base_will_rebuild$'
stdout '^gc_old_hint$'
exec devvm build base
stdout '^==> building_image image=base key='
exec devvm gc --force
stdout '^gc_image image=base key='

# A name that isn't a feature changes nothing.
! exec devvm setup --features fzf,nope
stderr '^devvm: no_feature feature=nope features=cli-tools desktop fzf omb$'
! stdout base_features
exec devvm setup
stdout '^==> base_features_none$'

# The default backend: only it, unless --features is given too.
exec devvm setup --backend lima
stdout '^==> default_backend backend=lima$'
! stdout base_features
cmp $XDG_CONFIG_HOME/devvm/backend lima.txt
exec devvm setup --backend lima --features fzf
stdout '^==> default_backend backend=lima$'
stdout '^==> base_features features=fzf$'
! exec devvm setup --backend nope
stderr '^devvm: backend_unknown backends=docker, lima, smolvm name=nope$'
cmp $XDG_CONFIG_HOME/devvm/backend lima.txt

# New VMs' size is devvm size -g's, and without a terminal nothing asks
# for it or for new VMs' network policy. Flags for a new VM are devvm
# [IMAGE]'s alone, so setup doesn't take them.
! exec devvm setup --cpus 2
stderr '^devvm: flag_unknown command=devvm setup flag=--cpus$'
! exec devvm setup --memory 8
stderr '^devvm: flag_unknown command=devvm setup flag=--memory$'
! exists $XDG_CONFIG_HOME/devvm/size
! exists $XDG_CONFIG_HOME/devvm/network

# --features none chooses none; --features '' is refused, and changes
# nothing.
exec devvm setup --features fzf
! exec devvm setup --features ''
stderr '^devvm: flag_blank flag=features$'
cmp $CHOSEN fzf.txt
exec devvm setup --features none
stdout '^==> base_features_none$'
exec cat $CHOSEN
! stdout .

# The network policy saved for new VMs: off makes one without it.
exec sh -c 'echo off > "$XDG_CONFIG_HOME/devvm/network"'
project off git
exec devvm --no-git-protect base
catg $VMS/devvm-off-*
stdout '^net=off$'
cd $WORK

# An unreadable choice stays for you to fix.
cp bad $CHOSEN
! exec devvm setup
stderr '^devvm: setup_failed reason=.*base-features'
cmp $CHOSEN bad

-- fzf-omb --
fzf
omb
-- lima.txt --
lima
-- fzf.txt --
fzf
-- bad --
Not_A_Feature
