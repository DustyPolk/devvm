# setup: base's features, and new VMs' size and network policy (all asked
# in a terminal, which Go tests cover; without one, the size and network
# policy aren't asked and the features are kept, or every one until
# they're chosen; --features without asking), each saved in
# settings.json. A new choice of features says base rebuilds, and once
# images are built that devvm gc deletes the old ones.
env SAVED=$DATA/settings.json

# Kept: none chosen; no size asked.
exec devvm setup
stdout '^==> base_features_none$'
! stdout base_will_rebuild
! stdout 'size_question|size_defaults'
! grep '"backend"|"size"|"agents"' $SAVED
grep '^  "features": \[\]$' $SAVED
! stdout default_agents
! stderr .
! stub_calls

# Unchosen: every feature.
rm $SAVED
exec devvm setup
stdout '^==> base_features features=cli-tools fzf omb$'
! stdout base_will_rebuild

# --features, in the order features run; nothing built yet.
exec devvm setup --features omb,fzf
stdout '^==> base_features features=fzf omb$'
stdout '^==> base_will_rebuild$'
! stdout gc_old_hint
grep '^  "features": \[\n    "fzf",\n    "omb"\n  \]$' $SAVED
exec devvm setup --features fzf,omb
! stdout base_will_rebuild

# Built: a new choice rebuilds base, and gc deletes the old one.
exec devvm build base
exec devvm setup --features none
stdout '^==> base_features_none$'
stdout '^==> base_will_rebuild$'
stdout '^gc_old_hint$'
exec devvm build base
stdout '^==> building_image image=base key='
exec devvm gc --force
stdout '^gc_image image=base key='

# A name that isn't a feature changes nothing.
! exec devvm setup --features fzf,nope
stderr '^devvm: no_feature feature=nope features=cli-tools desktop fzf omb$'
! stdout base_features
exec devvm setup
stdout '^==> base_features_none$'

# New VMs' size is devvm size -g's, and without a terminal nothing asks
# for it or for new VMs' network policy. Flags for a new VM are devvm's
# alone, so setup doesn't take them, and no command chooses a backend.
! exec devvm setup --backend lima
stderr '^devvm: flag_unknown command=devvm setup flag=--backend$'
! exec devvm setup --cpus 2
stderr '^devvm: flag_unknown command=devvm setup flag=--cpus$'
! exec devvm setup --memory 8
stderr '^devvm: flag_unknown command=devvm setup flag=--memory$'
! grep '"size"|"network"' $SAVED

# --features none chooses none; --features '' is refused, and changes
# nothing.
exec devvm setup --features fzf
! exec devvm setup --features ''
stderr '^devvm: flag_blank flag=features$'
grep '^  "features": \[\n    "fzf"\n  \]$' $SAVED
exec devvm setup --features none
stdout '^==> base_features_none$'
grep '^  "features": \[\]$' $SAVED

# The network policy saved for new VMs: off makes one without it.
exec devvm network -g off
project off git
exec devvm --no-git-protect
vm_name OFF off
catg $OFF_dir/state
stdout '^net=off$'
cd $WORK

# --agents: the coding agents new VMs get, without asking; none for none.
# An agent that isn't one is a usage error, with a did-you-mean.
exec devvm setup --agents claude,codex
stdout '^==> default_agents agents=claude codex$'
grep '^  "agents": \[\n    "claude",\n    "codex"\n  \]$' $SAVED
exec devvm setup --agents none
stdout '^==> default_agents_none$'
grep '^  "agents": \[\]$' $SAVED
! exec devvm setup --agents cladue
stderr '^devvm: unknown_part_like flag=--agents given=cladue like=claude$'
stderr '^usage_help command=devvm setup$'
! exec devvm setup --agents node
stderr '^devvm: part_other_flag flag=--agents given=node other=--tools$'
grep '^  "agents": \[\]$' $SAVED
# A new VM made without a terminal gets setup's agents, and says so.
exec devvm setup --agents codex
project agents git
exec devvm --no-network-policy --no-git-protect
stdout '^==> new_vm_gets layers=none tools=codex vm=devvm-agents-[0-9a-f]{14}$'
vm_name AGENTS agents
catg $AGENTS_dir/state
stdout '^tool_names=codex$'
cd $WORK

# What config.toml sets wins over settings.json, and devvm setup's flags
# can't change it: refused, naming the file and the key, with nothing
# saved.
cp config.toml $CFG/config.toml
! exec devvm setup --features omb
stderr '^devvm: set_in_config file=\S*/config/devvm/config\.toml key=features$'
! exec devvm setup --agents claude
stderr '^devvm: set_in_config file=\S*/config/devvm/config\.toml key=agents$'
grep '^  "agents": \[\n    "codex"\n  \]$' $SAVED
# Without a terminal, setup keeps config.toml's features, saying so.
exec devvm setup
stdout '^==> setup_in_config file=\S*/config/devvm/config\.toml key=features$'
! stdout base_features
rm $CFG/config.toml

# config.toml has no backend key: a file that sets one is refused.
cp backend.toml $CFG/config.toml
! exec devvm setup
stderr '^devvm: setup_failed reason=\S*/config/devvm/config\.toml:1: unknown key "backend"$'
rm $CFG/config.toml

# An unreadable choice stays for you to fix.
cp bad.json $SAVED
! exec devvm setup
stderr '^devvm: setup_failed reason=\S*/data/devvm/settings\.json: features: not a feature''s name: "Not_A_Feature"$'
cmp $SAVED bad.json

-- config.toml --
features = ["fzf"]
agents = ["opencode"]
-- backend.toml --
backend = "lima"
-- bad.json --
{"features": ["Not_A_Feature"]}
