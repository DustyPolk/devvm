# devvm's ssh config: every running project VM by name (devvm-<folder>,
# and its full name), checked against its own host keys, read from the VM
# once for each start into its own record; Lima's own settings that turn
# host key checks off, share a connection or run commands left out. The
# user's ~/.ssh is never touched.
project web
exec devvm --no-network-policy --no-git-protect
vm_name WEB web
catg $DATA/ssh_config
stdout '\A# Written by devvm on every launch; edits are overwritten\.\n\nHost devvm-web devvm-web-[0-9a-f]{14}\n'
stdout '^  HostKeyAlias devvm-web-[0-9a-f]{14}$'
stdout '^  UserKnownHostsFile "/\S*/data/devvm/vms/[0-9a-f]{14}/run/known_hosts"$'
stdout '^  StrictHostKeyChecking yes$'
stdout '^  NoHostAuthenticationForLocalhost no$'
stdout '^  ForwardAgent no$'
stdout '^  ControlMaster no$'
stdout '^  ControlPath none$'
stdout '^  ForwardX11 no$'
stdout '^  ForwardX11Trusted no$'
stdout '^  Tunnel no$'
stdout '^  PermitRemoteOpen none$'
stdout '^  AddKeysToAgent no$'
stdout '^  ProxyJump none$'
stdout '^  ProxyCommand none$'
stdout '^  UpdateHostKeys no$'
stdout '^  HashKnownHosts no$'
stdout '^  Hostname 127\.0\.0\.1$'
stdout '^  Port 60022$'
stdout '^  User stub$'
stdout '^  IdentityFile "/\S*/lima/_config/user"$'
stdout '^  IdentitiesOnly yes$'
! stdout 'StrictHostKeyChecking no|/dev/null|NoHostAuthenticationForLocalhost yes'
! stdout 'ControlMaster auto|ssh\.sock|ControlPersist|LocalCommand'
catg $WEB_dir/run/known_hosts
stdout '\A# devvm: host keys of start [0-9]+ \S+\ndevvm-web-[0-9a-f]{14} ssh-ed25519 \S+\n\z'
exec grep -c ' ssh-ed25519 ' $WEB_dir/run/known_hosts
stdout '^1$'
exec sh -c 'ls -l "$DATA/ssh_config" "$WEB_dir/run/known_hosts"'
! stdout '^-.{3}[^-]'
! exists $DATA/known_hosts
! exists $HOME/.ssh

# A stopped VM drops out; its keys stay. A project folder named like an
# image (img-foo) is a project VM; images and build VMs aren't listed.
cp $WEB_dir/run/known_hosts $WORK/web-keys
exec sh -c 'sed "s/^\(devvm-web-[0-9a-f]*\) Running$/\1 Stopped/" "$STUB_DIR/instances" > "$STUB_DIR/i" && mv "$STUB_DIR/i" "$STUB_DIR/instances"'
exec sh -c 'echo "devvm-img-0123456789ab Running" >> "$STUB_DIR/instances" && echo "devvm-tools-build Running" >> "$STUB_DIR/instances"'
project img-foo
exec devvm --no-network-policy --no-git-protect
catg $DATA/ssh_config
stdout '^Host devvm-img-foo devvm-img-foo-[0-9a-f]{14}$'
! stdout 'devvm-web|devvm-img-0123456789ab|devvm-tools-build'
cmp $WEB_dir/run/known_hosts $WORK/web-keys
vm_name IMG img-foo
catg $IMG_dir/run/known_hosts
stdout '^devvm-img-foo-[0-9a-f]{14} ssh-ed25519 '
! cmp $IMG_dir/run/known_hosts $WEB_dir/run/known_hosts

# A second folder named web: its VM by its full name only, as the first
# VM keeps devvm-web, chosen when it was made.
exec sh -c 'sed "s/^\(devvm-web-[0-9a-f]*\) Stopped$/\1 Running/" "$STUB_DIR/instances" > "$STUB_DIR/i" && mv "$STUB_DIR/i" "$STUB_DIR/instances"'
mkdir $WORK/other/web
cd $WORK/other/web
exec devvm --no-network-policy --no-git-protect
catg $DATA/ssh_config
stdout -count=1 '^Host devvm-web-[0-9a-f]{14}$'
stdout '^Host devvm-web '$WEB'$'
! stdout '^Host '$WEB'$'

# The record is read once for each start: a launch of the running VM
# keeps it, and keys recorded for another start are read again once it
# starts, not trusted.
exec sh -c 'sed "s/^\($IMG\) ssh-ed25519 .*/\1 ssh-ed25519 AAAAold/" "$IMG_dir/run/known_hosts" > "$WORK/kh" && cp "$WORK/kh" "$IMG_dir/run/known_hosts"'
cd $WORK/img-foo
exec devvm
catg $IMG_dir/run/known_hosts
stdout AAAAold
exec devvm restart
catg $IMG_dir/run/known_hosts
! stdout AAAAold
stdout '^devvm-img-foo-[0-9a-f]{14} ssh-ed25519 '

# A VM that doesn't show its host keys gets no entry: ssh couldn't check it.
exec sh -c ': > "$STUB_DIR/hostkeys-fail"'
project nokeys
exec devvm --no-network-policy --no-git-protect
vm_name NOKEYS nokeys
catg $DATA/ssh_config
! stdout devvm-nokeys
stdout '^Host devvm-img-foo '
! exists $NOKEYS_dir/run/known_hosts
rm $STUB_DIR/hostkeys-fail
! exists $HOME/.ssh
