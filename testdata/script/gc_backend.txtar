# gc --backend: one backend's images, current ones too, and its unused
# tool images, and nothing else; plain gc acts on every backend whatever
# the default backend file says. Never a VM.
env DEVVM_DOCKER_KIND=linux
env SHARE=$XDG_DATA_HOME/devvm/tools
env PACKS=$XDG_DATA_HOME/devvm/smolvm/images
env PIN=ubuntu:26.04@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# base on each backend; on Lima also foo, made stale.
mkdir $XDG_CONFIG_HOME/devvm/layers
cp foo.sh $XDG_CONFIG_HOME/devvm/layers/foo.sh
exec devvm build foo
exec devvm --backend smolvm --from $PIN build base
exec devvm --backend docker --from $PIN build base
exec sh -c 'echo "# edited" >> "$XDG_CONFIG_HOME/devvm/layers/foo.sh"'

# Unused tool images: one recorded as smolvm's, one as Lima's, one
# nobody can tell; claude's build makes the lock, so they're unused.
exec devvm build claude
exec sh -c 'cd "$SHARE" && for v in 1.1.0 1.2.0 1.3.0; do echo x > go-$v-0123456789ab.erofs; done'
exec sh -c 'printf "libc=gnu\nformat=plain-0123456789ab\n" > "$SHARE/go-1.1.0-0123456789ab.erofs.target"'
exec sh -c 'printf "libc=gnu\nformat=\n" > "$SHARE/go-1.2.0-0123456789ab.erofs.target"'

# The default backend file names smolvm: plain gc still acts on Lima.
exec sh -c 'echo smolvm > "$XDG_CONFIG_HOME/devvm/backend"'
stub_reset
exec devvm gc --force
stdout '^gc_image image=foo key=[0-9a-f]{12}$'
stdout '^gc_tools count=3 '
! stdout 'image=base'
exists $PACKS

# Again for smolvm alone: its base, current, and nothing of Lima's or
# Docker's; a smolvm tool image would go (none is left).
exec sh -c 'cd "$SHARE" && echo x > go-1.1.0-0123456789ab.erofs && echo x > go-1.2.0-0123456789ab.erofs'
exec sh -c 'printf "libc=gnu\nformat=plain-0123456789ab\n" > "$SHARE/go-1.1.0-0123456789ab.erofs.target"'
exec sh -c 'printf "libc=gnu\nformat=\n" > "$SHARE/go-1.2.0-0123456789ab.erofs.target"'
stub_reset
exec devvm gc --backend smolvm --force
stdout '^gc_image image=base key=[0-9a-f]{12}$'
stdout -count=1 '^gc_image '
stdout '^gc_tools count=1 '
! stdout gc_mise
exec sh -c 'ls "$PACKS" | wc -l'
stdout '^ *0$'
exists $SHARE/go-1.2.0-0123456789ab.erofs
! exists $SHARE/go-1.1.0-0123456789ab.erofs
stub_calls
! stdout '^limactl delete|^docker image rm|^docker rmi'

# Docker alone: its base goes; Lima's base stays.
stub_reset
exec devvm gc --backend docker --force
stdout -count=1 '^gc_image image=base '
stub_calls
! stdout '^limactl delete'
exec devvm images
stdout '^base +ubuntu 26\.04 .* +current +\S+ +lima$'
! stdout ' smolvm$| docker$'

# An unknown backend is refused.
! exec devvm --backend nope gc
stderr '^devvm: backend_unknown '

-- foo.sh --
#!/bin/bash
echo foo
