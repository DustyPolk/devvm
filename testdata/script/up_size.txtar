# A new VM's size and ports: the flags, else the defaults (config.toml's,
# else settings.json's), else the image's; checked before anything is
# built.
project sized

# Values that aren't sizes or port lists, and sizes this machine can't
# give or a disk smaller than the image's, are refused.
! exec devvm --no-network-policy --cpus 1.5
stderr '^devvm: cpus_not_number flag=--cpus value="1\.5"$'
! exec devvm --no-network-policy --cpus=0
stderr '^devvm: cpus_not_number flag=--cpus value="0"$'
! exec devvm --no-network-policy --memory 16M
stderr '^devvm: size_not_gib flag=--memory value="16M"$'
! exec devvm --no-network-policy --disk lots
stderr '^devvm: size_not_gib flag=--disk value="lots"$'
! exec devvm --no-network-policy --cpus 9999
stderr '^devvm: too_many_cpus have=8 want=9999$'
! exec devvm --no-network-policy --memory 99999
stderr '^devvm: too_much_memory have=16 max=14 want=99999$'
! exec devvm --no-network-policy --disk 50GiB
stderr '^devvm: disk_shrink have=100 vm=devvm-sized-[0-9a-f]{14} want=50$'
! exec devvm --no-network-policy --ports 0
stderr '^devvm: port_invalid value="0"$'
! exec devvm --no-network-policy --ports 8010-8000
stderr '^devvm: port_invalid value="8010-8000"$'
# Hand-edited defaults are checked too, naming config.toml's line.
cp $WORK/bad-size.toml $CFG/config.toml
! exec devvm --no-network-policy
stderr '\S*/config/devvm/config\.toml:2: size_not_gib flag=memory value="1\$\(touch x\)"$'
! exists x
cp $WORK/bad-ports.toml $CFG/config.toml
! exec devvm --no-network-policy
stderr '\S*/config/devvm/config\.toml:1: port_invalid '
rm $CFG/config.toml
stub_calls
! stdout 'create|clone'

# The flags: the VM's size changes after the clone, and its state says so;
# the ports it forwards are recorded as it's cloned, Lima's own forwards
# off.
exec devvm --no-network-policy --cpus 2 --memory=3G --disk 120GiB --ports '5173, 8000-8010,5173'
stub_calls
stdout '^limactl clone .* --set \.portForwards = \[\{"guestIP":"127\.0\.0\.1","guestPortRange":\[1,65535\],"proto":"any","ignore":true\},'
stdout '^limactl edit --tty=false devvm-sized-[0-9a-f]{14} --cpus 2 --memory 3 --disk 120$'
catg $DATA/lima-vms/devvm-sized-*.ports
stdout '\A5173,8000-8010\n\z'
catg $VMS/devvm-sized-*
stdout '^cpus=2$'
stdout '^memory=3$'
stdout '^disk=120$'
stdout '^ports=5173,8000-8010$'

# The defaults, for what the flags leave unset; nothing for what neither
# sets. A default of every port stores nothing. config.toml's memory wins
# over what devvm size -g saved.
project defaults
exec devvm size -g --memory 4
exec devvm ports -g none
cp $WORK/memory.toml $CFG/config.toml
stub_reset
exec devvm --no-network-policy --cpus 2
stub_calls
stdout '^limactl clone .* --set \.portForwards = \[\{"guestIP":"127\.0\.0\.1"'
stdout '^limactl edit --tty=false devvm-defaults-[0-9a-f]{14} --cpus 2 --memory 5$'
catg $VMS/devvm-defaults-*
stdout '^cpus=2$'
stdout '^memory=5$'
! stdout 'disk='
stdout '^ports=none$'
project all
rm $CFG/config.toml
cp $WORK/features-none.json $DATA/settings.json
stub_reset
exec devvm --no-network-policy
stub_calls
stdout '^limactl clone .* --set \.portForwards = \[\{"guestIP":"127\.0\.0\.1"'
! stdout 'limactl edit --tty=false devvm-all'
exec sh -c 'cat "$XDG_DATA_HOME"/devvm/lima-vms/devvm-all-*.ports "$XDG_DATA_HOME"/devvm/lima-vms/devvm-defaults-*.ports'
stdout '\Aall\nnone\n\z'
catg $VMS/devvm-all-*
! stdout 'ports|cpus|memory|disk'

# The first run, before base's features are chosen, asks for new VMs'
# size only in a terminal: without one it asks nothing and saves none.
project first
rm $DATA/settings.json
exec devvm --no-network-policy
! stdout 'size_question|size_defaults'
! stderr 'size_'
! grep '"size"' $DATA/settings.json
grep '"features"' $DATA/settings.json

-- features-none.json --
{"features": []}
-- memory.toml --
[size]
memory = 5
-- bad-size.toml --
[size]
memory = "1$(touch x)"
-- bad-ports.toml --
ports = "80]}]|.mounts=[{\"location\":\"~\""
