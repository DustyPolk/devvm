# scripts/bump.sh, on a scratch copy of the files it edits, with upstream
# answered by a curl that reads $WORK/up/ (repo.sh).
[!exec:jq] skip
env PATH=$WORK/bin:$PATH
chmod 755 bin/curl
exec bash repo.sh

# crane's version and checksums are written as they are.
exec repo/scripts/bump.sh crane
stdout '^  crane +0\.22\.1 +-> 9\.9\.9$'
stdout '^- crane: 0\.22\.1 -> 9\.9\.9$'
exec grep '^crane_' repo/assets/oci/build.sh
cmp stdout crane.want

# mise moves base's mise and devvm's host mise together.
exec repo/scripts/bump.sh mise
exec grep '^mise_' repo/assets/layers/base.sh
cmp stdout mise-base.want
exec grep -E 'miseVersion =|"(macos|linux)-' repo/internal/tools/mise.go
cmp stdout mise-go.want

# apt moves base's snapshot to today, and Ubuntu's cloud image to the
# newest dated release before the snapshot, with the checksums of its
# SHA256SUMS, checked with gpgv against Ubuntu's key.
exec repo/scripts/bump.sh apt
stdout '^  ubuntu-cloud +release-[0-9]{8} +-> release-20000101$'
exec grep '^apt_snapshot=' repo/assets/layers/base.sh
stdout '^apt_snapshot=[0-9]{8}T000000Z$'
exec grep '^const Cloud' repo/internal/ubuntu/ubuntu.go
cmp stdout cloud.want
stub_calls
stdout '^gpgv --keyring \S*/repo/assets/layers/ubuntu-cloud\.gpg \S*/SHA256SUMS\.gpg \S*/SHA256SUMS$'

# A cloud release whose checksums aren't signed by Ubuntu's key, no release
# before the snapshot, or a checksum that isn't one: refused, and nothing is
# edited.
exec bash repo.sh
cp repo/assets/layers/base.sh base.before
cp repo/internal/ubuntu/ubuntu.go ubuntu.before
exec touch $STUB_DIR/gpgv-bad
! exec repo/scripts/bump.sh apt
stderr '^bump: Ubuntu''s checksums for release-20000101 aren''t signed by Ubuntu''s cloud image key$'
cmp repo/assets/layers/base.sh base.before
cmp repo/internal/ubuntu/ubuntu.go ubuntu.before
rm $STUB_DIR/gpgv-bad
cp cloud-listing-future up/cloud-listing
! exec repo/scripts/bump.sh apt
stderr '^bump: Ubuntu has no cloud image release before the snapshot''s date [0-9]{8}$'
cmp repo/internal/ubuntu/ubuntu.go ubuntu.before
exec bash repo.sh
cp cloud-sums-hostile up/cloud-sums
! exec repo/scripts/bump.sh apt
stderr '^bump: upstream gave cloud_sha256_arm64 an unexpected value: '
cmp repo/internal/ubuntu/ubuntu.go ubuntu.before
cp cloud-sums-arm64 up/cloud-sums
! exec repo/scripts/bump.sh apt
stderr '^bump: upstream gave cloud_sha256_amd64 an unexpected value: '''''
cmp repo/internal/ubuntu/ubuntu.go ubuntu.before
! exists pwned

# Upstream values that aren't a version or a checksum are refused, and
# nothing is edited: a command for a checksum, one in a version, and a
# missing asset (an empty checksum).
exec bash repo.sh
cp repo/assets/oci/build.sh before
cp sums-hostile up/crane-sums
! exec repo/scripts/bump.sh crane
stderr '^bump: upstream gave crane_sha256_arm64 an unexpected value: '
cmp repo/assets/oci/build.sh before
cp sums-good up/crane-sums
cp latest-hostile up/crane-latest
! exec repo/scripts/bump.sh crane
stderr '^bump: upstream gave crane_version an unexpected value: '
cmp repo/assets/oci/build.sh before
cp latest-good up/crane-latest
cp sums-missing up/crane-sums
! exec repo/scripts/bump.sh crane
stderr '^bump: upstream gave crane_sha256_arm64 an unexpected value: '''''
cmp repo/assets/oci/build.sh before
! exists pwned

# The same for the host mise's pins, in Go.
cp repo/internal/tools/mise.go mise.go.before
cp mise-sums-hostile up/mise-sums
! exec repo/scripts/bump.sh mise
stderr '^bump: upstream gave mise_sha256 an unexpected value: '
cmp repo/internal/tools/mise.go mise.go.before
! exists pwned

# --check prints upstream's version without control characters.
cp latest-escape up/crane-latest
exec repo/scripts/bump.sh --check crane
stdout ' -> 9\.9\.9\[2J$'
! stdout '\x1b'
cmp repo/assets/oci/build.sh before

# An unknown tool: refused.
! exec repo/scripts/bump.sh nope
stderr '^bump: unknown tool ''nope'''

-- repo.sh --
# A copy of the files bump.sh edits, and upstream's good answers.
set -eu
rm -rf repo up
mkdir -p repo/scripts repo/assets/oci repo/assets/layers repo/internal/tools repo/internal/ubuntu up
cp "$DEVVM_REPO/scripts/bump.sh" repo/scripts/
cp "$DEVVM_REPO/assets/oci/build.sh" repo/assets/oci/
cp "$DEVVM_REPO/assets/layers/base.sh" "$DEVVM_REPO/assets/layers/ubuntu-cloud.gpg" repo/assets/layers/
cp "$DEVVM_REPO/internal/tools/mise.go" repo/internal/tools/
cp "$DEVVM_REPO/internal/ubuntu/ubuntu.go" repo/internal/ubuntu/
cp latest-good up/crane-latest
cp sums-good up/crane-sums
cp mise-latest up/mise-latest
cp mise-sums up/mise-sums
cp cloud-listing up/cloud-listing
cp cloud-sums up/cloud-sums
-- bin/curl --
#!/bin/bash
# Answers crane's and mise's releases and Ubuntu's cloud image release
# (release-20000101 only) from $WORK/up/; anything else fails.
for a in "$@"; do case $a in
  */go-containerregistry/releases/latest) cat "$WORK/up/crane-latest"; exit ;;
  */go-containerregistry/*/checksums.txt) cat "$WORK/up/crane-sums"; exit ;;
  */jdx/mise/releases/latest) cat "$WORK/up/mise-latest"; exit ;;
  */jdx/mise/*/SHASUMS256.txt) cat "$WORK/up/mise-sums"; exit ;;
  https://cloud-images.ubuntu.com/releases/resolute/) cat "$WORK/up/cloud-listing"; exit ;;
  */resolute/release-20000101/SHA256SUMS) cat "$WORK/up/cloud-sums"; exit ;;
  */resolute/release-20000101/SHA256SUMS.gpg) echo signature; exit ;;
esac; done
exit 22
-- cloud-listing --
<a href="release-19991231/">release-19991231/</a>
<a href="release-20000101/">release-20000101/</a> <a href="release-29990101/">release-29990101/</a>
<a href="current/">current/</a>
-- cloud-listing-future --
<a href="release-29990101/">release-29990101/</a>
