# A VM that exists: devvm opens it as it is, starting it if it's stopped,
# and sets it up again; flags for new VMs are ignored with a warning, and
# what its state asks of a stopped VM's size and ports is applied.
# restart stops it first.
env KNOWN=$DATA/known_hosts
project web git
exec devvm --no-network-policy
vm_name WEB web

# Running: opened without a start, its host keys kept, set up again.
stub_reset
exec devvm
! stdout 'starting|creating'
! stderr .
stub_calls
! stdout 'limactl (start|stop|clone|create|edit|delete)'
stdout '^limactl shell --workdir / devvm-web-[0-9a-f]{14} sh -c .*tar -xf - '
stdout '^limactl shell --workdir /\S*/web devvm-web-[0-9a-f]{14}\n\z'
exec grep -c '^devvm-web-' $KNOWN
stdout '^1$'

# Flags for new VMs: ignored, with a warning each.
exec devvm --network-policy --cpus 2 --ports none
stderr '^devvm: net_flag_ignored$'
stderr '^devvm: size_flags_ignored$'
stderr '^devvm: ports_flag_ignored$'
exec devvm --no-git-protect
stderr '^devvm: git_protect_flag_ignored$'
vm_state $WEB_dir/vm.json
stdout '^net.on=false$'

# A size its state asks for: a running VM's waits for its next start; a
# stopped one's is applied once.
json_set $WEB_dir/vm.json size.cpus=6
stub_reset
exec devvm
stderr '^devvm: size_next_start vm=devvm-web-[0-9a-f]{14}$'
stub_calls
! stdout 'limactl edit'

# Stopped: started, its host keys read again.
exec limactl stop $WEB
stub_reset
exec devvm
stdout '^==> starting vm=devvm-web-[0-9a-f]{14}$'
! stderr 'next_start'
stub_calls
stdout '^limactl edit --tty=false devvm-web-[0-9a-f]{14} --cpus 6$'
! stdout 'limactl edit .*portForwards'
stdout '^limactl start --tty=false devvm-web-[0-9a-f]{14}$'
stdout '^ssh -F none -M .* -l stub 127\.0\.0\.1 sh -s$'
stdout 'sh -c .*/etc/ssh/ssh_host_'
# (The stub's VM gets the size its edit asked for.)
exec sh -c 'echo "6 8589934592 107374182400" > "$STUB_DIR/size-$WEB"'
exec limactl stop $WEB
stub_reset
exec devvm
stub_calls
! stdout 'limactl edit'

# restart: stopped, then opened.
stub_reset
exec devvm restart
stdout '^==> starting vm=devvm-web-[0-9a-f]{14}$'
stub_calls
stdout '^limactl stop devvm-web-[0-9a-f]{14}\n(.*\n)*limactl start --tty=false devvm-web-[0-9a-f]{14}\n'
stdout '^limactl shell --workdir /\S*/web devvm-web-[0-9a-f]{14}\n\z'
! exec devvm restart base
stderr '^devvm: args_none command=devvm restart given=base$'

# --tools, --agents and --layers change nothing on a VM that exists: it
# opens as it is, warning that devvm tools changes its shared tools.
exec devvm --tools go --layers docker
stderr '^devvm: parts_flags_ignored vm=devvm-web-[0-9a-f]{14}$'
! stdout new_vm_gets
vm_state $WEB_dir/vm.json
stdout '^image=base$'
! stdout '^tools.names=.'
# Without them, nothing is said.
exec devvm
! stderr parts_flags_ignored

# A VM whose creation didn't finish (its state records no created time)
# never starts; rm deletes it.
json_set $WEB_dir/vm.json created:=null
exec limactl stop $WEB
stub_reset
! exec devvm
stderr '^devvm: vm_unfinished vm=devvm-web-[0-9a-f]{14}$'
! exec devvm restart
stderr '^devvm: vm_unfinished vm=devvm-web-[0-9a-f]{14}$'
stub_calls
! stdout 'limactl (start|stop)'

# rm: base has no agents, so nothing is exported; only this VM is
# deleted, with its state, logs (the rotated ones too), host keys and ssh config entry, and .git's
# locks taken off.
project api
exec devvm --no-network-policy
vm_name API api
cd $WORK/web
exec sh -c 'l="$WEB_dir/logs" && mkdir -p "$l" && touch "$l/network.jsonl" "$l/network.jsonl.1" "$l/proxy.log" "$l/proxy.log.1"'
stub_reset
exec devvm rm --force
stdout '^==> deleted vm=devvm-web-[0-9a-f]{14}$'
! stdout exported
stub_calls
stdout '^limactl delete -f devvm-web-[0-9a-f]{14}$'
! stdout 'delete -f devvm-api'
! stdout 'limactl (start|shell)'
[darwin] stdout '^chflags -R -P nouchg /\S*/web/\.git/config$'
! exists $WEB_dir
exists $API_dir/vm.json
exec cat $KNOWN
! stdout devvm-web
stdout devvm-api
exec cat $DATA/ssh_config
! stdout devvm-web
stdout devvm-api
! exec devvm rm --force
stderr '^devvm: no_vm dir=/\S*/web$'
! exec devvm restart
stderr '^devvm: no_vm dir=/\S*/web$'
! exec devvm tools update
stderr '^devvm: no_vm dir=/\S*/web$'
! exec devvm tools
stderr '^devvm: no_vm dir=/\S*/web$'
! exec devvm adopt
stderr '^devvm: no_vm dir=/\S*/web$'

# A delete that fails but leaves no VM cleans up like one that worked.
cd $WORK/api
exec sh -c ': > "$STUB_DIR/delete-fails"'
exec devvm rm --force --no-export
stdout '^==> deleted vm=devvm-api-[0-9a-f]{14}$'
! exists $API_dir
rm $STUB_DIR/delete-fails

# A folder made again at the same path: rm and adopt ask first, so
# without a terminal neither deletes nor takes the VM over.
project site
exec devvm --no-network-policy
cd $WORK
rm site
mkdir site
cd site
stub_reset
! exec devvm
stderr '^devvm: vm_other_folder vm=devvm-site-[0-9a-f]{14} was=/\S*/site$'
! exec devvm rm --force --no-export
stderr '^devvm: vm_other_folder_rm vm=devvm-site-[0-9a-f]{14} was=/\S*/site$'
! exec devvm adopt
stderr '^devvm: vm_other_folder_adopt vm=devvm-site-[0-9a-f]{14} was=/\S*/site$'
! exec devvm restart
stderr '^devvm: vm_other_folder '
stub_calls
! stdout 'limactl (delete|stop|start)'
vm_name SITE site
exists $SITE_dir/vm.json
