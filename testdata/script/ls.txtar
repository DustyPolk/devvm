# ls: project VMs on every backend, by name, with their status, image,
# .git protection, network policy, backend and folder. Images and build
# VMs aren't listed; a project VM named like an image is.
env DEVVM_MESSAGES=names
env VMS=$XDG_DATA_HOME/devvm/vms
env RUN=$XDG_DATA_HOME/devvm/run

# No VMs: the header alone, and nothing is asked of a backend but its list.
exec devvm ls
cmp stdout header.txt
! stderr .
stub_calls
stdout '^limactl list --json\nsmolvm machine ls( --state-dir \S+)? --json\n\z'

# A folder named img-foo gives a VM named like an image: listed, while
# the image it was made from isn't. No network policy: off.
mkdir $WORK/img-foo
cd $WORK/img-foo
exec devvm --no-network-policy --no-git-protect base
exec devvm ls
stdout '^NAME +STATUS +IMAGE +GIT +NET +BACKEND +FOLDER\n'
stdout '^devvm-img-foo-[0-9a-f]{14} +Running +base +off +off +lima +/\S*/img-foo\n\z'
! stdout '^devvm-img-[0-9a-f]{12} '

# Network policy: on while it runs on the hostagent devvm started (here
# the test's runner, which runs on); started some other way since, or a
# failed self-check, unenforced. Stopped, it starts confined next time.
mkdir $WORK/net
cd $WORK/net
exec devvm --network-policy --no-git-protect base
exec sh -c 'n=$(basename "$VMS"/devvm-net-*); echo $PPID > "$LIMA_HOME/$n/ha.pid"; echo "$PPID 1" > "$RUN/$n.started"'
exec devvm ls
stdout '^devvm-net-[0-9a-f]{14} +Running +base +off +on +lima '
exec sh -c 'n=$(basename "$VMS"/devvm-net-*); limactl stop "$n" && limactl start --tty=false "$n"'
exec devvm ls
stdout '^devvm-net-[0-9a-f]{14} +Running +base +off +unenforced +lima '
exec sh -c 'limactl stop "$(basename "$VMS"/devvm-net-*)"'
exec devvm ls
stdout '^devvm-net-[0-9a-f]{14} +Stopped +base +off +on +lima '
exec sh -c 'f=$(ls "$VMS"/devvm-net-*); { grep -v ^net_check= "$f"; echo net_check=unenforced; } > "$WORK/st" && mv "$WORK/st" "$f"'
exec devvm ls
stdout '^devvm-net-[0-9a-f]{14} +Stopped +base +off +unenforced +lima '

# A --clone VM shows clone in GIT, a base from a container image its
# label, and a VM whose creation didn't finish - for what it lacks.
cp $WORK/clone.state $VMS/devvm-cl-0123456789abcd
cp $WORK/from.state $VMS/devvm-from-0123456789abcd
exec sh -c 'printf "devvm-cl-0123456789abcd\ndevvm-from-0123456789abcd Running\ndevvm-half-0123456789abcd\ndevvm-tools-build\n" >> "$STUB_DIR/instances"'
exec devvm ls
stdout '^devvm-cl-0123456789abcd +Stopped +node +clone +on +lima +/p/cl\n'
stdout '^devvm-from-0123456789abcd +Running +image_from from=node:24 image=base +on +off +lima +/p/from\n'
stdout '^devvm-half-0123456789abcd +Stopped +- +- +- +lima +-\n'
! stdout devvm-tools-build
# Sorted by name.
stdout '\ndevvm-cl-.*\ndevvm-from-.*\ndevvm-half-.*\ndevvm-img-foo-.*\ndevvm-net-'

# Lima can't list (not installed): fails, as a VM's state names it; with
# none, the header alone.
env PATH=$DEVVM_BIN
! exec devvm ls
! stdout .
stderr '^devvm: lima_missing$'
rm $VMS
exec devvm ls
cmp stdout $WORK/header.txt

-- header.txt --
NAME  STATUS  IMAGE  GIT  NET  BACKEND  FOLDER
-- clone.state --
image=node
dir=/p/cl
backend=lima
net=on
mode=clone
-- from.state --
image=base
dir=/p/from
from=node:24
backend=lima
net=off
git_protect=on
