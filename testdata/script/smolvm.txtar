# The smolvm backend (experimental), on the smolvm stub: its checks, base
# built as a pack from a container image, a project VM made from it with
# everything set, and the features it lacks refused in one line naming the
# VM. Registries are never reached: the pinned image needs no lookup, and
# HTTPS_PROXY points at nothing. On Linux every call has --state-dir.
env DEVVM_MESSAGES=names
env VMS=$XDG_DATA_HOME/devvm/vms
env PACKS=$XDG_DATA_HOME/devvm/smolvm/images
env HTTPS_PROXY=http://127.0.0.1:9
env https_proxy=http://127.0.0.1:9
env PIN=ubuntu:26.04@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Its checks: smolvm 1.32 or newer.
exec devvm doctor --backend smolvm
stdout '^doctor_ok backend=smolvm version=\S+$'
exec sh -c 'echo 1.31.0 > "$STUB_DIR/smolvm-version"'
! exec devvm doctor --backend smolvm
stderr '^devvm: smolvm_old'
rm $STUB_DIR/smolvm-version

# Base: a machine from the image by its digest, labelled, with base.yaml's
# size and the internet; prepared, its scripts run between the stand-ins,
# then packed and deleted.
exec devvm --backend smolvm --from $PIN build base
stdout '^==> building_image_from from=ubuntu:26.04@sha256:a+ image=base key=[0-9a-f]{12}$'
stub_calls
stdout '^smolvm machine create( --state-dir \S+)? --name devvm-img-([0-9a-f]{12}) --label devvm\.data=\S+/data/devvm --cpus 4 --mem 8192 --storage 100 -v /var/lib/docker --net --image ubuntu:26\.04@sha256:a+$'
stdout '^smolvm machine start( --state-dir \S+)? --name devvm-img-[0-9a-f]{12}$'
stdout '^smolvm machine exec( --state-dir \S+)? --name devvm-img-[0-9a-f]{12} -i -- sh -s -- \S+ \d+$'
stdout '^smolvm machine exec( --state-dir \S+)? --name devvm-img-[0-9a-f]{12} -i -- sh -s -- on$'
stdout '^smolvm machine exec( --state-dir \S+)? --name devvm-img-[0-9a-f]{12} -i -u \S+ -w / .* -- sh -c .* sh bash -s$'
stdout '^smolvm machine exec( --state-dir \S+)? --name devvm-img-[0-9a-f]{12} -i -- sh -s -- off$'
stdout '^smolvm pack create( --state-dir \S+)? --from-vm devvm-img-[0-9a-f]{12} -o \S+/smolvm/images/[0-9a-f]{12}\.tmp/image$'
stdout '^smolvm machine delete( --state-dir \S+)? --name devvm-img-[0-9a-f]{12} -f$'
! stdout limactl
exec sh -c 'ls "$PACKS"/*/image.smolmachine'
exec devvm images
stdout '^base +ubuntu:26\.04@sha256:a+ +a{12} +[0-9a-f]{12} +current +\S+ +smolvm$'

# A new VM forwards every port by default, which smolvm emulates
# (reviewed): none of smolvm's forwards; once its sshd runs, a forwarder of
# devvm's on the host reaches it over ssh (a master, offering the VM's key
# alone, its host key read through smolvm and pinned), and forwards what
# listens in the VM. The ports that listen in it are ones free here.
free_port UNLISTED LISTED
mkdir $WORK/all
cd $WORK/all
exec sh -c 'printf "0100007F:%04X\n00000000:0050\n" "$UNLISTED" > "$STUB_DIR/guest-ports"; : > "$STUB_LOG"'
exec devvm --backend smolvm --from $PIN --no-network-policy base
! stderr 'backend_unreviewed'
! stderr 'ports_'
stub_calls
stdout '^smolvm machine create( --state-dir \S+)? --name devvm-all-[0-9a-f]{14} .* -v \S+:/mnt/devvm-tools:ro --ssh-agent$'
stdout '^smolvm machine exec( --state-dir \S+)? --name devvm-all-[0-9a-f]{14} -- cat /etc/ssh/ssh_host_ed25519_key\.pub$'
stdout '^ssh -F none -M -S \S+/data/devvm/run/smolvm-[0-9a-f]{16}\.ctl -T .* -o IdentityFile=\S+/smolvm/vms/devvm-all-[0-9a-f]{14}\.key .* -o HostKeyAlias=devvm-all-[0-9a-f]{14} .* -o PermitRemoteOpen=none -o ClearAllForwardings=yes .* -p [0-9]+ -l \S+ 127\.0\.0\.1 sh -s$'
exec sh -c 'cat "$XDG_DATA_HOME"/devvm/smolvm/vms/devvm-all-*.ports.known_hosts'
stdout '^devvm-all-[0-9a-f]{14} ssh-ed25519 AAAAstub$'
exec sh -c 'cat "$XDG_DATA_HOME"/devvm/smolvm/vms/devvm-all-*.ports.log'
stdout '^devvm ports: port '$UNLISTED': forwarded$'
stdout '^devvm ports: forwarding devvm-all-[0-9a-f]{14}''s ports$'
! stdout 'port 80'
exec devvm stop
exec devvm rm -f
! exec sh -c 'ls "$XDG_DATA_HOME"/devvm/smolvm/vms/devvm-all-*'
rm $STUB_DIR/guest-ports
mkdir $WORK/web
cd $WORK/web

# Listed ports: made from base's pack with everything set (a pack would
# give it its build machine's), started, set up, then the shell. smolvm
# forwards none of its ports, only its ssh: devvm's forwarder forwards the
# listed ports alone (LISTED listens in the VM, and UNLISTED).
exec sh -c 'printf "0100007F:%04X\n0100007F:%04X\n" "$LISTED" "$UNLISTED" > "$STUB_DIR/guest-ports"'
exec devvm --backend smolvm --from $PIN --no-network-policy --ports $LISTED,8000-8001 --cpus 2 base
stdout '^==> creating_from image=base vm=devvm-web-[0-9a-f]{14}$'
! stderr 'ports_'
stub_calls
stdout '^smolvm machine create( --state-dir \S+)? --name devvm-web-[0-9a-f]{14} --label devvm\.data=\S+ --from \S+/image\.smolmachine --cpus 2 --mem \d+ --storage 100 -v /var/lib/docker -v (\S+)/web:\S+/web -v \S+/data/devvm/tools:/mnt/devvm-tools:ro --ssh-agent$'
stdout '^smolvm machine update( --state-dir \S+)? --name devvm-web-[0-9a-f]{14} --net -p [0-9]+:22$'
! stdout ' -p ('$LISTED'|8000)'
stdout '^smolvm machine start( --state-dir \S+)? --name devvm-web-[0-9a-f]{14}$'
stdout '^smolvm machine exec( --state-dir \S+)? --name devvm-web-[0-9a-f]{14} -i -- sh -s -- ssh \S+ ssh-ed25519 \S+ devvm NODE_EXTRA_CA_CERTS PIP_CERT REQUESTS_CA_BUNDLE SSL_CERT_FILE UV_SYSTEM_CERTS$'
stdout '^smolvm machine exec( --state-dir \S+)? --name devvm-web-[0-9a-f]{14} -i( -t)? -u \S+ -w \S+/web .* bash -l$'
! stderr 'backend_unreviewed'
exec sh -c 'cat "$XDG_DATA_HOME"/devvm/smolvm/vms/devvm-web-*.ports.log'
stdout '^devvm ports: port '$LISTED': forwarded$'
stdout '^devvm ports: forwarding devvm-web-[0-9a-f]{14}''s ports$'
! stdout 'port '$UNLISTED':'
exists $STUB_DIR/sync.tar
exec devvm ls
stdout '^devvm-web-[0-9a-f]{14} +Running .*image=base +\S+ +off +smolvm +\S+/web$'
grep '^Host devvm-web devvm-web-[0-9a-f]{14}$' $XDG_CONFIG_HOME/devvm/ssh_config

# A listed port a program on this machine has, on any address, isn't
# forwarded from a start that finds it so, warned: the forwarder forwards
# the rest, and smolvm none.
listen_any TAKEN
exec devvm stop
exec devvm ports add $TAKEN
exec sh -c 'printf "0100007F:%04X\n0100007F:%04X\n" "$LISTED" "$TAKEN" >"$STUB_DIR/guest-ports"; : > "$STUB_LOG"; : > "$(ls "$XDG_DATA_HOME"/devvm/smolvm/vms/devvm-web-*.ports.log)"'
exec devvm
stderr '^devvm: ports_taken count=1 ports='$TAKEN' vm=devvm-web-[0-9a-f]{14}$'
! stderr 'ports_forward_failed'
stub_calls
! stdout '^smolvm machine (create|update) .* -p '
! stdout '--remove-port'
exec sh -c 'cat "$XDG_DATA_HOME"/devvm/smolvm/vms/devvm-web-*.ports.log'
stdout '^devvm ports: port '$LISTED': forwarded$'
! stdout 'port '$TAKEN
exec devvm ports
stdout '^'$LISTED',8000-8001,'$TAKEN'$'
# Running: a change starts its forwarder again at once, the VM running on.
exec sh -c ': > "$STUB_LOG"'
exec devvm ports rm 8000-8001
stdout '^==> ports_forwarding ports='$LISTED','$TAKEN' vm=devvm-web-[0-9a-f]{14}$'
stderr '^devvm: ports_taken count=1 ports='$TAKEN' vm=devvm-web-[0-9a-f]{14}$'
stub_calls
! stdout '^smolvm machine (stop|start|update)'
exec sh -c 'ps -axww -o command= | grep "[_]smolvm-ports -vm devvm-web-" | grep -F -- "-key $XDG_DATA_HOME/devvm/"'
stdout ' -only '$LISTED'$'
rm $STUB_DIR/guest-ports

# Its agent forwarding can be turned on later (emulated, reviewed): made
# forwarding, and given no agent, a path no socket can be at.
exec sh -c 'cat "$VMS"/devvm-web-*'
stdout '^net=off$'
stdout '^ssh_agent=off$'
stdout '^agent_toggle=on$'
exec sh -c 'cat "$STUB_DIR"/smolvm-agent-devvm-web-*'
stdout '^/dev/null/devvm-no-agent$'

# rm deletes the machine and what the backend recorded for it.
exec sh -c 'ls "$XDG_DATA_HOME"/devvm/smolvm/vms/devvm-web-*.json'
exec devvm rm -f
stdout '^==> deleted vm=devvm-web-[0-9a-f]{14}$'
! exec sh -c 'ls "$XDG_DATA_HOME"/devvm/smolvm/vms/devvm-web-*.json'
exec devvm ls
! stdout devvm-web

# Network policy (emulated, reviewed). The proxy decides too, on a port of
# its own, with a token in a file; the machine's allow list is the gateway,
# its DNS a name that doesn't exist, its proxy settings the gateway's, and it
# starts through the decider, the token in no arguments or logs; the
# self-check passes.
mkdir $WORK/pol
cd $WORK/pol
exec sh -c ': > "$STUB_LOG"'
exec devvm --backend smolvm --from $PIN --network-policy --ports none base
! stderr 'backend_unreviewed'
exec sh -c 'cat "$VMS"/devvm-pol-*'
stdout '^net=on$'
stdout '^net_check=ok$'
stdout '^decider_port=[0-9]+$'
stdout '^decider_token=[0-9a-f]{64}$'
stub_calls
stdout '^smolvm machine update( --state-dir \S+)? --name devvm-pol-[0-9a-f]{14} --reset-allow-list --allow-cidr 100\.96\.0\.1/32 --allow-host-pattern devvm\.invalid -p [0-9]+:22$'
! stdout ' -e HTTPS?_PROXY='
stdout '^smolvm machine start( --state-dir \S+)? --name devvm-pol-[0-9a-f]{14} --mediated-egress --egress-interceptor 127\.0\.0\.1:[0-9]+$'
stdout '^smolvm machine exec( --state-dir \S+)? --name devvm-pol-[0-9a-f]{14} --secret-file HTTP_PROXY=\S+/smolvm/vms/devvm-pol-[0-9a-f]{14}\.proxy .* curl --noproxy \* -sS -m 3 -o /dev/null https://1\.1\.1\.1$'
# The proxy's URL is in the machine's proxy file (mode 600), which each exec
# names: never in smolvm's arguments.
exec sh -c 'key=$(sed -n "s/^proxy_key=//p" "$VMS"/devvm-pol-*); f=$(ls "$XDG_DATA_HOME"/devvm/smolvm/vms/devvm-pol-*.proxy); grep -qE "^http://devvm:$key@100\.96\.0\.1:[0-9]+$" "$f" && ! grep -qF "$key" "$STUB_LOG" && ls -l "$f"'
stdout '^-rw-------\S* '
# The password is in no run log.
exec sh -c 'key=$(sed -n "s/^proxy_key=//p" "$VMS"/devvm-pol-*); ! grep -rqF "$key" "$XDG_DATA_HOME"/devvm/logs/runs'
exec sh -c 'grep -F "deciding on 127.0.0.1:$(sed -n "s/^decider_port=//p" "$VMS"/devvm-pol-*) for devvm-pol-" "$XDG_DATA_HOME"/devvm/logs/devvm-pol-*.proxy.log'
exec sh -c 'cat "$STUB_DIR"/smolvm-decider-devvm-pol-*'
stdout '^127\.0\.0\.1:[0-9]+ [0-9a-f]{64}$'
exec sh -c 'tok=$(sed -n "s/^decider_token=//p" "$VMS"/devvm-pol-*); [ "$(cat "$XDG_DATA_HOME"/devvm/run/devvm-pol-*.proxy.decider)" = "$tok" ] && ! grep -qF "$tok" "$STUB_LOG" && ! grep -rqF "$tok" "$XDG_DATA_HOME"/devvm/logs'
# Running, with its proxy gone and the decider's port taken by another
# program: stopped, never left running without it.
exec sh -c 'pp=$(sed -n "s/^proxy_port=//p" "$VMS"/devvm-pol-*); dp=$(sed -n "s/^decider_port=//p" "$VMS"/devvm-pol-*); pkill -f -- "_proxy -listen 127.0.0.1:$pp "; sleep 0.5; echo k > "$WORK/squat.key"; devvm _proxy -listen "127.0.0.1:$dp" -auth-file "$WORK/squat.key" -lifeline "$WORK/squat.none" >/dev/null 2>&1 & echo $! > "$WORK/squat.pid"; sleep 1'
exec sh -c ': > "$STUB_LOG"'
! exec devvm
stderr '^devvm: net_proxy_down_stopped vm=devvm-pol-[0-9a-f]{14}$'
stderr '^devvm: proxy_port_taken port=[0-9]+ vm=devvm-pol-[0-9a-f]{14}$'
stub_calls
stdout '^smolvm machine stop( --state-dir \S+)? --name devvm-pol-[0-9a-f]{14}$'
! stdout 'bash -l$'
exec sh -c 'kill "$(cat "$WORK/squat.pid")"'
exec devvm rm -f
stdout '^==> deleted vm=devvm-pol-[0-9a-f]{14}$'

# ssh for editors (emulated, reviewed): each start forwards the VM's sshd
# from a host loopback port and runs it with the VM's own key; the ssh
# config reaches it by name with that key alone, its host keys read through
# smolvm and pinned.
mkdir $WORK/sshd
cd $WORK/sshd
exec sh -c ': > "$STUB_LOG"'
exec devvm --backend smolvm --from $PIN --no-network-policy --ports 5173 base
! stderr 'backend_unreviewed'
stub_calls
stdout '^smolvm machine update( --state-dir \S+)? --name devvm-sshd-[0-9a-f]{14} --net -p [0-9]+:22$'
stdout '^smolvm machine exec( --state-dir \S+)? --name devvm-sshd-[0-9a-f]{14} -i -- sh -s -- ssh \S+ ssh-ed25519 \S+ devvm NODE_EXTRA_CA_CERTS PIP_CERT REQUESTS_CA_BUNDLE SSL_CERT_FILE UV_SYSTEM_CERTS$'
exec sh -c 'ls -l "$XDG_DATA_HOME"/devvm/smolvm/vms/devvm-sshd-*.key'
stdout '^-rw-------\S* '
grep '^Host devvm-sshd devvm-sshd-[0-9a-f]{14}$' $XDG_CONFIG_HOME/devvm/ssh_config
grep '^  Hostname 127\.0\.0\.1$' $XDG_CONFIG_HOME/devvm/ssh_config
grep '^  Port [0-9]+$' $XDG_CONFIG_HOME/devvm/ssh_config
grep '^  IdentityFile ".+/smolvm/vms/devvm-sshd-[0-9a-f]{14}\.key"$' $XDG_CONFIG_HOME/devvm/ssh_config
grep '^  ForwardX11 no$' $XDG_CONFIG_HOME/devvm/ssh_config
grep '^  AddKeysToAgent no$' $XDG_CONFIG_HOME/devvm/ssh_config
grep '^  IdentitiesOnly yes$' $XDG_CONFIG_HOME/devvm/ssh_config
grep '^  ForwardAgent no$' $XDG_CONFIG_HOME/devvm/ssh_config
grep '^devvm-sshd-[0-9a-f]{14} ssh-ed25519 AAAAstub$' $XDG_CONFIG_HOME/devvm/known_hosts
exec devvm host
stdout '^ssh_host_info dir=\S+/sshd host=devvm-sshd$'
# An image without sshd: the start runs the rest without it, warned; no
# entry, and devvm host says so.
exec sh -c 'touch "$STUB_DIR/no-sshd"; : > "$STUB_LOG"'
exec devvm restart
stderr '^devvm: vm_no_sshd vm=devvm-sshd-[0-9a-f]{14}$'
stub_calls
stdout '^smolvm machine exec( --state-dir \S+)? --name devvm-sshd-[0-9a-f]{14} -i -- sh -s --$'
! grep 'devvm-sshd' $XDG_CONFIG_HOME/devvm/ssh_config
! exec devvm host
stderr '^devvm: vm_no_sshd vm=devvm-sshd-[0-9a-f]{14}$'
rm $STUB_DIR/no-sshd
exec devvm rm -f
stdout '^==> deleted vm=devvm-sshd-[0-9a-f]{14}$'
! exec sh -c 'ls "$XDG_DATA_HOME"/devvm/smolvm/vms/devvm-sshd-*.key'

# Any number of listed ports, 22 among them: all the forwarder's, none of
# smolvm's.
mkdir $WORK/many
cd $WORK/many
exec sh -c ': > "$STUB_LOG"'
exec devvm --backend smolvm --from $PIN --no-network-policy --ports 22,3000-3100 base
! stderr 'backend_unreviewed'
stub_calls
stdout '^smolvm machine create( --state-dir \S+)? --name devvm-many-[0-9a-f]{14} .* --ssh-agent$'
! stdout ' -p (22|3000):'
exec devvm ports
stdout '^22,3000-3100$'
exec devvm rm -f

# Agent forwarding turned on or off (emulated, reviewed): a new VM is made
# forwarding (--ssh-agent), and each start gives it the agent its choice
# names: none (a path no socket can be at), devvm's own, or yours; a change
# waits for its next start. devvm's own SSH_AUTH_SOCK never reaches smolvm
# otherwise.
env SSH_AUTH_SOCK=$WORK/user.sock
mkdir $WORK/agent
cd $WORK/agent
exec sh -c ': > "$STUB_LOG"'
exec devvm --backend smolvm --from $PIN --no-network-policy --ports none base
! stderr 'backend_unreviewed'
stub_calls
stdout '^smolvm machine create( --state-dir \S+)? --name devvm-agent-[0-9a-f]{14} .* --ssh-agent$'
exec sh -c 'cat "$VMS"/devvm-agent-*'
stdout '^ssh_agent=off$'
stdout '^agent_toggle=on$'
exec sh -c 'cat "$STUB_DIR"/smolvm-agent-devvm-agent-*'
stdout '^/dev/null/devvm-no-agent$'
exec devvm ssh-agent devvm
exec sh -c 'cat "$STUB_DIR"/smolvm-agent-devvm-agent-*'
stdout '^/dev/null/devvm-no-agent$'
exec devvm
exec sh -c 'cat "$XDG_CONFIG_HOME/devvm/ssh_config"'
stdout '^Host devvm-agent devvm-agent-[0-9a-f]{14}\n(  .*\n)*  ForwardAgent no\n'
exec devvm restart
exec sh -c 'cat "$STUB_DIR"/smolvm-agent-devvm-agent-*'
stdout '^\S+/data/devvm/agent\.sock$'
exec sh -c 'cat "$XDG_CONFIG_HOME/devvm/ssh_config"'
stdout '^Host devvm-agent devvm-agent-[0-9a-f]{14}\n(  .*\n)*  ForwardAgent "\S+/data/devvm/agent\.sock"\n'
exec devvm ssh-agent on
exec devvm restart
exec sh -c 'cat "$STUB_DIR"/smolvm-agent-devvm-agent-*'
stdout '^\S+/user\.sock$'
exec devvm ssh-agent off
exec devvm restart
exec sh -c 'cat "$STUB_DIR"/smolvm-agent-devvm-agent-*'
stdout '^/dev/null/devvm-no-agent$'
# Started outside devvm (smolvm machine start from the user's shell, with
# its agent): stopped, as it may forward an agent devvm didn't choose; then
# devvm starts it again, with none.
exec devvm stop
exec sh -c 'smolvm machine start --name "$(basename "$VMS"/devvm-agent-*)"'
exec sh -c 'cat "$STUB_DIR"/smolvm-agent-devvm-agent-*'
stdout '^\S+/user\.sock$'
exec sh -c ': > "$STUB_LOG"'
! exec devvm
stderr '^devvm: agent_unchosen_stop vm=devvm-agent-[0-9a-f]{14}$'
stub_calls
stdout '^smolvm machine stop( --state-dir \S+)? --name devvm-agent-[0-9a-f]{14}$'
! stdout 'bash -l$'
exec devvm
exec sh -c 'cat "$STUB_DIR"/smolvm-agent-devvm-agent-*'
stdout '^/dev/null/devvm-no-agent$'
# Its own start, kept: devvm doesn't stop it.
exec devvm host
! stderr 'agent_unchosen'
# With the user's agent, nothing to keep from it: started outside devvm,
# it runs on.
exec devvm ssh-agent on
exec devvm stop
exec sh -c 'smolvm machine start --name "$(basename "$VMS"/devvm-agent-*)"'
exec devvm
! stderr 'agent_unchosen'
exec devvm rm -f
