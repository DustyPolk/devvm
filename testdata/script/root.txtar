# devvm --help prints usage.
exec devvm --help
stdout '^Usage:'
stdout 'devvm \[IMAGE\] \[flags\]'
! stderr .
cp stdout help.txt

# So do devvm help and -h; devvm help COMMAND prints the command's.
exec devvm help
cmp stdout help.txt
exec devvm -h
cmp stdout help.txt
exec devvm help build
stdout 'devvm build IMAGE \[flags\]'
exec devvm build --help
stdout 'devvm build IMAGE \[flags\]'
! stub_calls

# An unknown flag is a usage error: its message on stderr, then the line
# naming the command's own help.
env DEVVM_MESSAGES=names
! exec devvm --nope
cmp stderr nope-flag.txt
! stdout .
! exec devvm stop --nope
stderr '^devvm: flag_unknown command=devvm stop flag=--nope$'
stderr '^usage_help command=devvm stop$'

# So is a command given too many arguments, naming those its help shows.
! exec devvm build a b
cmp stderr build-args.txt
! stdout .
! stub_calls

-- nope-flag.txt --
devvm: flag_unknown command=devvm flag=--nope
usage_help command=devvm
-- build-args.txt --
devvm: args_too_many args=IMAGE command=devvm build given=a b
usage_help command=devvm build
