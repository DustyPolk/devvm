# doctor: what the backend new VMs get needs on this machine and how to
# get what's missing, each backend's features, and whether Docker is
# there. --json prints what it found as JSON, for scripts, and nothing
# else.
env ALL=$PATH
chmod 0755 brew/brew
chmod 0755 broken/limactl
chmod 0755 qemu/qemu-system-aarch64
chmod 0755 qemu/qemu-system-x86_64
chmod 0755 qemu/qemu-img

# Everything there: only limactl --version runs.
exec devvm doctor
stdout '^FEATURE +LIMA\n'
stdout '^build-image +native\n'
stdout '^egress-proxy +native\n'
stdout '^ports +emulated\n'
stdout '^ports-all +emulated\n'
stdout '^agent-toggle +native\n'
stdout '^disk +native\n'
stdout '^docker-layer +native\n'
stdout '^docker_found\n'
stdout '^doctor_ok backend=lima version=\S+\n\z'
! stderr .
stub_calls
stdout '^limactl --version\n\z'
exec devvm doctor --json
stdout '^{\n  "version": 1,\n  "backend": "lima",\n  "backend_source": "built-in",\n  "problems": \[\],\n  "warnings": \[\],\n  "docker": true,\n'
stdout '^      "ports": "emulated",$'
! stderr .

# Where the backend came from: a file that sets it is named, and --json
# says which, or flag for --backend.
exec devvm setup --backend lima
exec devvm doctor
stdout '^doctor_backend_from backend=lima file=\S*/data/devvm/settings\.json$'
exec devvm doctor --json
stdout '"backend_source": "settings.json",'
cp lima.toml $CFG/config.toml
exec devvm doctor
stdout '^doctor_backend_from backend=lima file=\S*/config/devvm/config\.toml$'
exec devvm doctor --json --backend lima
stdout '"backend_source": "flag",'
rm $CFG/config.toml

# Another backend, or one devvm doesn't have.
! exec devvm doctor --backend nope
stderr '^devvm: backend_unknown backends=lima name=nope$'
! stdout .

# No Lima, no Homebrew, no Docker: what to install, and it fails.
# QEMU's there, which only Linux checks.
env PATH=$WORK/qemu${:}$DEVVM_BIN
! exec devvm doctor
stdout '^FEATURE +LIMA\n'
stdout '^docker_missing\n'
! stdout doctor_ok
stderr '^devvm: lima_missing$'
exec devvm doctor --json
stdout '^      "key": "lima",\n      "fix": null,\n      "message": "lima_missing"\n'
stdout '^  "docker": false,$'
! stderr .

# Every command that needs the backend stops at the first problem.
! exec devvm build base
stderr '^devvm: lima_missing$'
mkdir p
cd p
! exec devvm --no-network-policy
stderr '^devvm: lima_missing$'
cd ..

# With Homebrew, its command.
env PATH=$WORK/brew${:}$WORK/qemu${:}$DEVVM_BIN
exec devvm doctor --json
stdout '^      "key": "lima",\n      "fix": "brew install lima",\n      "message": "lima_missing_fix fix=brew install lima"\n'

# A limactl that doesn't run, as one built for another processor.
env PATH=$WORK/broken${:}$WORK/brew${:}$WORK/qemu${:}$DEVVM_BIN
exec devvm doctor --json
stdout '^      "key": "lima",\n      "fix": "brew reinstall lima",\n      "message": "lima_broken_fix fix=brew reinstall lima"\n'
! exec devvm doctor
stderr '^devvm: lima_broken_fix fix=brew reinstall lima$'

# One of Lima's global configs in devvm's Lima home, listed after the
# rest.
mkdir $DEVVM_LIMA_HOME/_config
cp default.yaml $DEVVM_LIMA_HOME/_config/default.yaml
! exec devvm doctor
stderr '^devvm: lima_broken_fix fix=brew reinstall lima\ndevvm: lima_global_config files=\S+/_config/default.yaml\n\z'
env PATH=$ALL
! exec devvm doctor
stderr '^devvm: lima_global_config files=\S+/_config/default.yaml$'
exec devvm doctor --json
stdout '^  "problems": \[\n    {\n      "key": "lima-config",\n      "fix": null,\n      "message": "lima_global_config files=\S+/_config/default.yaml"\n    }\n  \],$'

-- lima.toml --
backend = "lima"
-- brew/brew --
#!/bin/sh
-- broken/limactl --
#!/bin/sh
exit 126
-- qemu/qemu-system-aarch64 --
#!/bin/sh
-- qemu/qemu-system-x86_64 --
#!/bin/sh
-- qemu/qemu-img --
#!/bin/sh
-- default.yaml --
networks: [{vzNAT: true}]
