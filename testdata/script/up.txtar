# devvm in a folder: its VM, created from its image with only the folder
# mounted, its state, .git protection, started, then a shell in the
# folder in place of devvm.
env DEVVM_MESSAGES=names
env VMS=$XDG_DATA_HOME/devvm/vms
mkdir $WORK/web
cd $WORK/web
exec git init -q

# Network policy isn't there yet: without --no-network-policy (or with
# --network-policy), nothing is built or created.
! exec devvm base
stderr '^devvm: network_policy_unavailable vm=devvm-web-[0-9a-f]{14}$'
! exec devvm --network-policy base
stderr '^devvm: network_policy_unavailable vm=devvm-web-[0-9a-f]{14}$'
stub_calls
! stdout 'create|clone|start'
! exists $VMS
! exec devvm --network-policy --no-network-policy base
stderr 'usage_error'

# A new VM: base built, then cloned with only the folder, read-write, no
# agent forwarding, every port; started, and devvm's last act is the shell,
# in the folder.
exec devvm --no-network-policy base
stdout '^==> building_image image=base key=[0-9a-f]{12}$'
stdout '^==> creating_from image=base vm=devvm-web-[0-9a-f]{14}$'
stdout '^==> starting vm=devvm-web-[0-9a-f]{14}$'
stub_calls
stdout '^limactl clone --tty=false devvm-img-[0-9a-f]{12} devvm-web-[0-9a-f]{14} --mount-none --set \.mounts = \[\{"location":"[^"]*/web","writable":true\}\] --set \.ssh\.forwardAgent=false --set \.ssh\.localPort=0 --set \.portForwards = \[\]$'
! stdout 'limactl edit --tty=false devvm-web'
stdout '^limactl start --tty=false devvm-web-[0-9a-f]{14}$'
stdout 'limactl shell --workdir /\S*/web devvm-web-[0-9a-f]{14}\n\z'
# .git's hooks and config locked (macOS); elsewhere, a warning.
[darwin] stdout '^chflags -R -P uchg /\S*/web/\.git/hooks$'
[darwin] stdout '^chflags -R -P uchg /\S*/web/\.git/config$'
[darwin] ! stderr git_protect_needs_macos_new
[linux] ! stdout chflags
[linux] stderr '^devvm: git_protect_needs_macos_new$'
exec sh -c 'cat "$VMS"/devvm-web-*'
stdout '^image=base$'
stdout '^dir=/\S*/web$'
stdout '^folder=[0-9]+:[0-9]+'
stdout '^chain=base=[0-9a-f]{12}$'
stdout '^backend=lima$'
stdout '^net=off$'
[darwin] stdout '^git_protect=on$'
[darwin] stdout '^git_inode=[0-9]+$'
[linux] stdout '^git_protect=off$'
! stdout 'cpus=|memory=|disk=|ports='
# limactl ran from devvm's data folder, never the project folder.
exec cat $STUB_DIR/limactl-env
stdout '^cwd=/\S*/data/devvm '

# Once it exists, devvm doesn't open it yet. A folder made again at the
# same path never gets the old one's VM.
! exec devvm --no-network-policy base
stderr '^devvm: vm_exists vm=devvm-web-[0-9a-f]{14}$'
cd $WORK
rm web
mkdir web
cd web
! exec devvm --no-network-policy base
stderr '^devvm: vm_other_folder vm=devvm-web-[0-9a-f]{14} was=/\S*/web$'

# --no-git-protect: nothing locked. An SSH origin gets a hint: the VM
# has no SSH agent.
mkdir $WORK/api
cd $WORK/api
exec git init -q
exec git remote add origin git@github.com:o/api.git
exec sh -c ': > "$STUB_LOG"'
exec devvm --no-network-policy --no-git-protect base
! stdout building_image
stderr '^devvm: ssh_remote_hint vm=devvm-api-[0-9a-f]{14}$'
! stderr git_protect_needs_macos_new
stub_calls
! stdout chflags
exec sh -c 'cat "$VMS"/devvm-api-*'
stdout '^git_protect=off$'

# Linux hosts: set-id files in the folder are named (they reach the host).
[linux] mkdir $WORK/setid
[linux] cd $WORK/setid
[linux] exec sh -c 'touch tool && chmod u+s tool'
[linux] exec devvm --no-network-policy base
[linux] stderr '^devvm: setid_files files=/\S*/setid/tool$'

# Ctrl+C before the VM's first shell deletes it and its state, and takes
# off .git's locks; nothing else.
mkdir $WORK/slow
cd $WORK/slow
exec git init -q
exec sh -c ': > "$STUB_LOG" && : > "$STUB_DIR/start-hangs"'
! exec devvm --no-network-policy base &u&
wait_file $STUB_DIR/hanging
kill -INT u
wait u
stdout '^==> interrupted_vm vm=devvm-slow-[0-9a-f]{14}$'
stub_calls
stdout '^limactl delete -f devvm-slow-[0-9a-f]{14}$'
[darwin] stdout '^chflags -R -P uchg /\S*/slow/\.git/config\n(.*\n)*chflags -R -P nouchg /\S*/slow/\.git/config$'
[darwin] stdout '^chflags -R -P nouchg /\S*/slow/\.git/hooks$'
! stdout 'delete -f devvm-(web|api)'
! stdout 'nouchg /\S*/(web|api)/'
! stdout 'limactl shell --workdir'
exec sh -c 'ls "$VMS"'
! stdout devvm-slow
stdout devvm-web
exec sh -c 'grep -c devvm-slow "$STUB_DIR/instances" || true'
stdout '^0$'
rm $STUB_DIR/start-hangs
