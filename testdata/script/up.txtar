# devvm in a folder: its VM, created from its image with only the folder
# mounted, its state, .git protection, started, then a shell in the
# folder in place of devvm.
project web git

# Network policy on and off at once: nothing is built or created.
! exec devvm --network-policy --no-network-policy base
stderr '^devvm: flags_exclusive flag=--network-policy other=--no-network-policy$'
stub_calls
! stdout 'create|clone|start'
! exists $VMS

# A new VM: base built, then cloned with only the folder, read-write, and
# the shared tools, read-only; no agent forwarding; Lima's own port
# forwards off; started, its host key pinned and its ports forwarded by
# devvm's forwarder over Lima's ssh, set up, and devvm's last act is the
# shell, in the folder.
exec devvm --no-network-policy base
stdout '^==> building_image image=base key=[0-9a-f]{12}$'
stdout '^==> creating_from image=base vm=devvm-web-[0-9a-f]{14}$'
stdout '^==> starting vm=devvm-web-[0-9a-f]{14}$'
# .git unprotected off macOS, and devvm says so.
[darwin] ! stderr git_protect_needs_macos_new
[linux] stderr '^devvm: git_protect_needs_macos_new$'
stub_calls
stdout '^limactl clone --tty=false devvm-img-[0-9a-f]{12} devvm-web-[0-9a-f]{14} --mount-none --set \.mounts = \[\{"location":"[^"]*/web","writable":true\},\{"location":"[^"]*/data/devvm/tools","mountPoint":"/mnt/devvm-tools","writable":false\}\] --set \.ssh\.forwardAgent=false --set \.ssh\.localPort=[1-9][0-9]+ --set \.portForwards = \[\{"guestIP":"127\.0\.0\.1","guestPortRange":\[1,65535\],"proto":"any","ignore":true\},\{"guestIP":"0\.0\.0\.0","guestPortRange":\[1,65535\],"proto":"any","ignore":true\},\{"guestIP":"::","guestPortRange":\[1,65535\],"proto":"any","ignore":true\}\] --set \.env = \{"NODE_EXTRA_CA_CERTS":.*\}$'
! stdout 'limactl edit --tty=false devvm-web'
! stdout 'devvm-tools-build'
stdout '^limactl start --tty=false devvm-web-[0-9a-f]{14}\nlimactl shell --workdir / devvm-web-[0-9a-f]{14} sh -c .*/etc/ssh/ssh_host_.*\n'
stdout '^ssh -F none -M -S \S+/data/devvm/run/lima-[0-9a-f]{16}\.ctl -T .* -o IdentityFile=\S+/lima/_config/user .* -o UserKnownHostsFile=\S+/data/devvm/lima-vms/devvm-web-[0-9a-f]{14}\.ports\.known_hosts .* -o HostKeyAlias=devvm-web-[0-9a-f]{14} .* -p 60022 -l stub 127\.0\.0\.1 sh -s$'
! stdout '^(docker|smolvm) '
stdout '^limactl shell --workdir / devvm-web-[0-9a-f]{14} sh -c cd ''/'' && exec ''bash'' ''-c'' ''d=\$\(mktemp -d\); tar -xf - .*''\n(limactl list --json\n)+limactl shell --workdir /\S*/web devvm-web-[0-9a-f]{14}\n\z'
exists $XDG_DATA_HOME/devvm/tools
! exists $XDG_DATA_HOME/devvm/mise.lock
# .git's hooks and config locked (macOS); elsewhere, not.
[darwin] stdout '^chflags -R -P uchg /\S*/web/\.git/hooks$'
[darwin] stdout '^chflags -R -P uchg /\S*/web/\.git/config$'
[linux] ! stdout chflags
# The forwarder pins the host key devvm pinned; the VM forwards every port.
exec sh -c 'cat "$XDG_DATA_HOME"/devvm/lima-vms/devvm-web-*.ports.known_hosts "$XDG_DATA_HOME"/devvm/lima-vms/devvm-web-*.ports; grep -c "^devvm-web-[0-9a-f]* $(cut -d" " -f2- "$XDG_DATA_HOME"/devvm/lima-vms/devvm-web-*.ports.known_hosts)$" "$XDG_CONFIG_HOME"/devvm/known_hosts'
stdout '\Adevvm-web-[0-9a-f]{14} ssh-ed25519 \S+\nall\n1\n\z'
catg $VMS/devvm-web-*
stdout '^image=base$'
stdout '^dir=/\S*/web$'
stdout '^folder=[0-9]+:[0-9]+'
stdout '^chain=base=[0-9a-f]{12}$'
stdout '^backend=lima$'
stdout '^net=off$'
stdout '^libc=gnu$'
! stdout '^tools='
[darwin] stdout '^git_protect=on$'
[darwin] stdout '^git_inode=[0-9]+$'
[linux] stdout '^git_protect=off$'
! stdout 'cpus=|memory=|disk=|ports='
# Its ssh port is devvm's, recorded before the clone that sets it, so
# other VMs' forwarders never take it.
exec sh -c 'p=$(sed -n "s/^ssh_port=//p" "$VMS"/devvm-web-*) && grep -c -- "^limactl clone .* --set \.ssh\.localPort=$p " "$STUB_LOG"'
stdout '^1$'
# limactl ran from devvm's data folder, never the project folder.
exec cat $STUB_DIR/limactl-env
stdout '^cwd=/\S*/data/devvm '

# A folder made again at the same path never gets the old one's VM.
cd $WORK
rm web
mkdir web
cd web
! exec devvm --no-network-policy base
stderr '^devvm: vm_other_folder vm=devvm-web-[0-9a-f]{14} was=/\S*/web$'

# --no-git-protect: nothing locked. An SSH origin gets a hint: the VM
# has no SSH agent.
project api git
exec git remote add origin git@github.com:o/api.git
stub_reset
exec devvm --no-network-policy --no-git-protect base
! stdout building_image
stderr '^devvm: ssh_remote_hint vm=devvm-api-[0-9a-f]{14}$'
! stderr git_protect_needs_macos_new
stub_calls
! stdout chflags
catg $VMS/devvm-api-*
stdout '^git_protect=off$'

# Launches ask only the backends a VM's state names: with only Lima's VMs,
# neither docker nor smolvm runs, for a new VM or an existing one.
stub_calls
! stdout '^(docker|smolvm) '
stub_reset
exec devvm --no-network-policy base
! stdout creating_from
stub_calls
stdout '^limactl list --json$'
! stdout '^(docker|smolvm) '

# Linux hosts: set-id files in the folder are named (they reach the host).
[linux] mkdir $WORK/setid
[linux] cd $WORK/setid
[linux] exec sh -c 'touch tool && chmod u+s tool'
[linux] exec devvm --no-network-policy base
[linux] stderr '^devvm: setid_files files=/\S*/setid/tool$'

# Ctrl+C before the VM's first shell deletes it and its state, and takes
# off .git's locks; nothing else.
project slow git
exec sh -c ': > "$STUB_LOG" && : > "$STUB_DIR/start-hangs"'
! exec devvm --no-network-policy base &u&
wait_file $STUB_DIR/hanging
kill -INT u
wait u
stdout '^==> interrupted_vm vm=devvm-slow-[0-9a-f]{14}$'
stub_calls
stdout '^limactl delete -f devvm-slow-[0-9a-f]{14}$'
[darwin] stdout '^chflags -R -P uchg /\S*/slow/\.git/config\n(.*\n)*chflags -R -P nouchg /\S*/slow/\.git/config$'
[darwin] stdout '^chflags -R -P nouchg /\S*/slow/\.git/hooks$'
! stdout 'delete -f devvm-(web|api)'
! stdout 'nouchg /\S*/(web|api)/'
! stdout 'limactl shell --workdir'
exec sh -c 'ls "$VMS"'
! stdout devvm-slow
stdout devvm-web
exec sh -c 'grep -c devvm-slow "$STUB_DIR/instances" || true'
stdout '^0$'
rm $STUB_DIR/start-hangs
